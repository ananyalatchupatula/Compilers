**PROCEDURE: main
 Return Type: <void>
  Formal Parameters:
   **BEGIN: Abstract Syntax Tree    
Write: String : "Enter your percentage "<string>
    Read: Name : marks_<float>
     Asgn:
      LHS (Name : grade_<string>)
      RHS (
       Condition: LT<bool>        L_Opd (Name : marks_<float>)        R_Opd (Num : 40.00<float>)
       True_Part (String : "F"<string>)
       False_Part (
        Condition: AND<bool>
         L_Opd (
          Condition: GE<bool>           L_Opd (Name : marks_<float>)           R_Opd (Num : 40.00<float>))
         R_Opd (
          Condition: LT<bool>           L_Opd (Name : marks_<float>)           R_Opd (Num : 50.00<float>))
        True_Part (String : "D"<string>)
        False_Part (
         Condition: AND<bool>
          L_Opd (
           Condition: GE<bool>            L_Opd (Name : marks_<float>)            R_Opd (Num : 50.00<float>))
          R_Opd (
           Condition: LT<bool>            L_Opd (Name : marks_<float>)            R_Opd (Num : 60.00<float>))
         True_Part (String : "C"<string>)
         False_Part (
          Condition: AND<bool>
           L_Opd (
            Condition: GE<bool>             L_Opd (Name : marks_<float>)             R_Opd (Num : 60.00<float>))
           R_Opd (
            Condition: LT<bool>             L_Opd (Name : marks_<float>)             R_Opd (Num : 70.00<float>))
          True_Part (String : "B"<string>)
          False_Part (String : "A"<string>))))))))       
Write: String : "The grade obtained is: "<string>       
Write: Name : grade_<string>
    **END: Abstract Syntax Tree