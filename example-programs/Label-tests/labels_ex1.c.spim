.data
i1_: .word 0
i2_: .word 0
a_: .word 0
st_: .word 0
stg_: .word 0
f1_: .double 0.0
f2_: .double 0.0

.text          # The .text assembler directive indicates
    .globl func1_      # The following is the code (as opposed to data)
func1_:                # .globl makes main know to the outside of the program.
# Prologue begins
    sw $ra, 0($sp)    # Save the return address
    sw $fp, -4($sp)   # Save the frame pointer
    sub $fp, $sp, 4   # Update the frame pointer
    sub $sp, $sp, 16  # Make space for the locals
# Prologue ends

    li $v0, 5
    sw $v0, i2_
    li.d $f2, 5.00
    s.d $f2, f2_
Label5:
    lw $v0, i2_
    li $t1, 7
    slt $t0, $v0, $t1
    xori $v0, $t0, 1
    bgtz $v0, Label6
    li $v0, 1
    lw $a0, i2_
    syscall
    lw $v0, i2_
    li $t1, 1
    add $t0, $v0, $t1
    sw $t0, i2_
    j Label5
Label6:
    lw $v0, i2_
    sw $v0, -8($fp)
    j Label7
epilogue_func1_:
    add $sp, $sp, 16  # Increment stack pointer for local variables
    lw $fp, -4($sp)   # Set $fp to $sp-4
    lw $ra, 0($sp)    # Save ra
    jr $ra            # Jump back to the called procedure
# Epilogue Ends

.text          # The .text assembler directive indicates
    .globl func11_      # The following is the code (as opposed to data)
func11_:                # .globl makes main know to the outside of the program.
# Prologue begins
    sw $ra, 0($sp)    # Save the return address
    sw $fp, -4($sp)   # Save the frame pointer
    sub $fp, $sp, 4   # Update the frame pointer
    sub $sp, $sp, 12  # Make space for the locals
# Prologue ends

    li $v0, 5
    sw $v0, i1_
Label8:
    lw $v0, i1_
    li $t1, 7
    slt $t0, $v0, $t1
    xori $v0, $t0, 1
    bgtz $v0, Label9
    li $v0, 1
    lw $a0, i1_
    syscall
    lw $v0, i1_
    li $t1, 1
    add $t0, $v0, $t1
    sw $t0, i1_
    j Label8
Label9:
    li $v0, 1
    sw $v0, -4($fp)
    j Label2
Label2:
    lw $v1, -4($fp)
    j epilogue_func11_
epilogue_func11_:
    add $sp, $sp, 12  # Increment stack pointer for local variables
    lw $fp, -4($sp)   # Set $fp to $sp-4
    lw $ra, 0($sp)    # Save ra
    jr $ra            # Jump back to the called procedure
# Epilogue Ends

.text          # The .text assembler directive indicates
    .globl func2_      # The following is the code (as opposed to data)
func2_:                # .globl makes main know to the outside of the program.
# Prologue begins
    sw $ra, 0($sp)    # Save the return address
    sw $fp, -4($sp)   # Save the frame pointer
    sub $fp, $sp, 4   # Update the frame pointer
    sub $sp, $sp, 12  # Make space for the locals
# Prologue ends

    lw $v0, 8($fp)
    li $t1, 10
    add $t0, $v0, $t1
    sw $t0, 8($fp)
    li $v0, 5
    sw $v0, 20($fp)
    lw $v0, 8($fp)
    lw $t1, 20($fp)
    add $t0, $v0, $t1
    lw $t1, i2_
    add $v0, $t0, $t1
    li $t1, 2
    add $t0, $v0, $t1
    sw $t0, -4($fp)
    j Label3
Label3:
    lw $v1, -4($fp)
    j epilogue_func2_
epilogue_func2_:
    add $sp, $sp, 12  # Increment stack pointer for local variables
    lw $fp, -4($sp)   # Set $fp to $sp-4
    lw $ra, 0($sp)    # Save ra
    jr $ra            # Jump back to the called procedure
# Epilogue Ends

.text          # The .text assembler directive indicates
    .globl func3_      # The following is the code (as opposed to data)
func3_:                # .globl makes main know to the outside of the program.
# Prologue begins
    sw $ra, 0($sp)    # Save the return address
    sw $fp, -4($sp)   # Save the frame pointer
    sub $fp, $sp, 4   # Update the frame pointer
    sub $sp, $sp, 16  # Make space for the locals
# Prologue ends

    l.d $f2, 12($fp)
    l.d $f6, f2_
    add.d $f4, $f2, $f6
    s.d $f4, 12($fp)
    l.d $f2, 20($fp)
    li.d $f6, 10.50
    add.d $f4, $f2, $f6
    s.d $f4, 20($fp)
    l.d $f2, 12($fp)
    l.d $f6, 20($fp)
    add.d $f4, $f2, $f6
    s.d $f4, -8($fp)
    j Label4
Label4:
    l.d $f0, -8($fp)
    j epilogue_func3_
epilogue_func3_:
    add $sp, $sp, 16  # Increment stack pointer for local variables
    lw $fp, -4($sp)   # Set $fp to $sp-4
    lw $ra, 0($sp)    # Save ra
    jr $ra            # Jump back to the called procedure
# Epilogue Ends

.text          # The .text assembler directive indicates
    .globl func4_      # The following is the code (as opposed to data)
func4_:                # .globl makes main know to the outside of the program.
# Prologue begins
    sw $ra, 0($sp)    # Save the return address
    sw $fp, -4($sp)   # Save the frame pointer
    sub $fp, $sp, 4   # Update the frame pointer
    sub $sp, $sp, 12  # Make space for the locals
# Prologue ends

    li $v0, 4
    sw $v0, i1_
    lw $v0, i1_
    lw $t1, i1_
    add $t0, $v0, $t1
    sw $t0, -4($fp)
    j Label0
Label0:
    lw $v1, -4($fp)
    j epilogue_func4_
epilogue_func4_:
    add $sp, $sp, 12  # Increment stack pointer for local variables
    lw $fp, -4($sp)   # Set $fp to $sp-4
    lw $ra, 0($sp)    # Save ra
    jr $ra            # Jump back to the called procedure
# Epilogue Ends

.text          # The .text assembler directive indicates
    .globl apple_      # The following is the code (as opposed to data)
apple_:                # .globl makes main know to the outside of the program.
# Prologue begins
    sw $ra, 0($sp)    # Save the return address
    sw $fp, -4($sp)   # Save the frame pointer
    sub $fp, $sp, 4   # Update the frame pointer
    sub $sp, $sp, 12  # Make space for the locals
# Prologue ends

    li $v0, 5
    sw $v0, i1_
    lw $v0, i1_
    sw $v0, -4($fp)
    j Label1
Label1:
    lw $v1, -4($fp)
    j epilogue_apple_
epilogue_apple_:
    add $sp, $sp, 12  # Increment stack pointer for local variables
    lw $fp, -4($sp)   # Set $fp to $sp-4
    lw $ra, 0($sp)    # Save ra
    jr $ra            # Jump back to the called procedure
# Epilogue Ends

.text          # The .text assembler directive indicates
    .globl main      # The following is the code (as opposed to data)
main:                # .globl makes main know to the outside of the program.
# Prologue begins
    sw $ra, 0($sp)    # Save the return address
    sw $fp, -4($sp)   # Save the frame pointer
    sub $fp, $sp, 4   # Update the frame pointer
    sub $sp, $sp, 8  # Make space for the locals
# Prologue ends

    jal func1_
    move $v0, $v1
    sw $v0, a_
    jal func4_
    move $v0, $v1
    sw $v0, i2_
    lw $v0, i2_
    sw $v0, 0($sp)
    sub $sp, $sp, 4
    l.d $f2, f2_
    s.d $f2, -4($sp)
    sub $sp, $sp, 8
    lw $v0, i1_
    sw $v0, 0($sp)
    sub $sp, $sp, 4
    jal func2_
    add $sp, $sp, 4
    add $sp, $sp, 8
    add $sp, $sp, 4
    move $v0, $v1
    sw $v0, i2_
    l.d $f2, f2_
    s.d $f2, -4($sp)
    sub $sp, $sp, 8
    l.d $f2, f1_
    s.d $f2, -4($sp)
    sub $sp, $sp, 8
    lw $v0, i1_
    sw $v0, 0($sp)
    sub $sp, $sp, 4
    jal func3_
    add $sp, $sp, 4
    add $sp, $sp, 8
    add $sp, $sp, 8
    mov.d $f2, $f0
    s.d $f2, f2_
    jal apple_
    move $v0, $v1
    sw $v0, st_
    jal func11_
    move $v0, $v1
    sw $v0, stg_
    li $v0, 3
    l.d $f12, f1_
    syscall
    li $v0, 3
    l.d $f12, f2_
    syscall
    li $v0, 1
    lw $a0, a_
    syscall
    li $v0, 1
    lw $a0, st_
    syscall
    li $v0, 1
    lw $a0, stg_
    syscall
epilogue_main:
    add $sp, $sp, 8  # Increment stack pointer for local variables
    lw $fp, -4($sp)   # Set $fp to $sp-4
    lw $ra, 0($sp)    # Save ra
    jr $ra            # Jump back to the called procedure
# Epilogue Ends

