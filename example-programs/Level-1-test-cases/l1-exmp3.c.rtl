**PROCEDURE: main
**BEGIN: RTL Statements
    iLoad:	v0 <- 0			;; Loading integer number 0
    store:	b_ <- v0
    load_addr:	v0 <- _str_0
    store:	s_ <- v0
    load_addr:	v0 <- _str_1
    store:	k_ <- v0
    iLoad:	v0 <- 4			;; Loading integer number 4
    load:	a0 <- s_			;; Moving the value to be printed into register a0
    write				;; This is where syscall will be made
    iLoad:	v0 <- 1			;; Loading integer number 1
    load:	a0 <- b_			;; Moving the value to be printed into register a0
    write				;; This is where syscall will be made
    iLoad:	v0 <- 5			;; Loading integer number 5
    read				;; This is where syscall will be made
    store:	a_ <- v0
    load:	v0 <- a_			;; Loading variable a_ into register
    store:	b_ <- v0
    iLoad:	v0 <- 1			;; Loading integer number 1
    load:	a0 <- b_			;; Moving the value to be printed into register a0
    write				;; This is where syscall will be made
**END: RTL Statements
