    load.d:	f2 <- t_			;; Loading variable t_ into register
    div.d:	f6 <- f2 , f4
    load.d:	f2 <- s_			;; Loading variable s_ into register
    div.d:	f4 <- f2 , f6
    load.d:	f2 <- r_			;; Loading variable r_ into register
