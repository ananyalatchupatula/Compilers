    store.d:	y_ <- f2
    iLoad.d:	f2 <- 4.00			;; Loading integer number 4.00
    store.d:	z_ <- f2
    load:	v0 <- e_			;; Loading variable e_ into register
    load:	t1 <- f_			;; Loading variable f_ into register
    mul:	t0 <- v0 , t1
    load:	v0 <- g_			;; Loading variable g_ into register
    load:	t2 <- h_			;; Loading variable h_ into register
    sub:	t1 <- v0 , t2
    load:	t2 <- i_			;; Loading variable i_ into register
    div:	v0 <- t1 , t2
    add:	t1 <- t0 , v0
    load:	v0 <- d_			;; Loading variable d_ into register
    div:	t0 <- v0 , t1
    load:	t1 <- j_			;; Loading variable j_ into register
    div:	v0 <- t0 , t1
    load:	t0 <- l_			;; Loading variable l_ into register
    load:	t2 <- m_			;; Loading variable m_ into register
    add:	t1 <- t0 , t2
    load:	t2 <- n_			;; Loading variable n_ into register
    sub:	t0 <- t1 , t2
    load:	t1 <- k_			;; Loading variable k_ into register
    mul:	t2 <- t1 , t0
    add:	t0 <- v0 , t2
    load:	v0 <- c_			;; Loading variable c_ into register
    mul:	t1 <- v0 , t0
    load:	v0 <- b_			;; Loading variable b_ into register
    add:	t0 <- v0 , t1
    store:	a_ <- t0
    load.d:	f2 <- y_			;; Loading variable y_ into register
    load.d:	f6 <- z_			;; Loading variable z_ into register
    div.d:	f4 <- f2 , f6
    load.d:	f2 <- x_			;; Loading variable x_ into register
    div.d:	f6 <- f2 , f4
    load.d:	f2 <- w_			;; Loading variable w_ into register
