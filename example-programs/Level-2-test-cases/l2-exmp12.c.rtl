    store:	l_ <- v0
    iLoad:	v0 <- 3			;; Loading integer number 3
    store:	m_ <- v0
    iLoad:	v0 <- 4			;; Loading integer number 4
    store:	n_ <- v0
    iLoad.d:	f2 <- 3.00			;; Loading integer number 3.00
    store.d:	q_ <- f2
    iLoad.d:	f2 <- 4.00			;; Loading integer number 4.00
    store.d:	r_ <- f2
    iLoad.d:	f2 <- 3.00			;; Loading integer number 3.00
    store.d:	s_ <- f2
    iLoad.d:	f2 <- 4.00			;; Loading integer number 4.00
    store.d:	t_ <- f2
    iLoad.d:	f2 <- 3.00			;; Loading integer number 3.00
    store.d:	u_ <- f2
    iLoad.d:	f2 <- 4.00			;; Loading integer number 4.00
    store.d:	v_ <- f2
    iLoad.d:	f2 <- 3.00			;; Loading integer number 3.00
    store.d:	w_ <- f2
    iLoad.d:	f2 <- 4.00			;; Loading integer number 4.00
    store.d:	x_ <- f2
