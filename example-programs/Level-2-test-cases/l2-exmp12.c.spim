.text          # The .text assembler directive indicates
    .globl main      # The following is the code (as opposed to data)
main:                # .globl makes main know to the outside of the program.
# Prologue begins
    sw $ra, 0($sp)    # Save the return address
    sw $fp, -4($sp)   # Save the frame pointer
    sub $fp, $sp, 4   # Update the frame pointer
    sub $sp, $sp, 144  # Make space for the locals
# Prologue ends

    li $v0, 3
    sw $v0, -8($fp)
    li $v0, 4
    sw $v0, -12($fp)
    li $v0, 3
    sw $v0, -16($fp)
    li $v0, 4
    sw $v0, -20($fp)
    li $v0, 3
    sw $v0, -24($fp)
    li $v0, 4
    sw $v0, -28($fp)
    li $v0, 3
    sw $v0, -32($fp)
    li $v0, 4
    sw $v0, -36($fp)
    li $v0, 3
    sw $v0, -40($fp)
    li $v0, 4
    sw $v0, -44($fp)
    li $v0, 3
    sw $v0, -48($fp)
    li $v0, 4
    sw $v0, -52($fp)
    li $v0, 3
    sw $v0, -56($fp)
    li $v0, 4
    sw $v0, -60($fp)
    li.d $f2, 3.00
    s.d $f2, -64($fp)
    li.d $f2, 4.00
    s.d $f2, -72($fp)
    li.d $f2, 3.00
    s.d $f2, -80($fp)
    li.d $f2, 4.00
    s.d $f2, -88($fp)
    li.d $f2, 3.00
    s.d $f2, -96($fp)
    li.d $f2, 4.00
    s.d $f2, -104($fp)
    li.d $f2, 3.00
    s.d $f2, -112($fp)
    li.d $f2, 4.00
    s.d $f2, -120($fp)
    li.d $f2, 3.00
    s.d $f2, -128($fp)
    li.d $f2, 4.00
    s.d $f2, -136($fp)
    lw $v0, -24($fp)
    lw $t1, -28($fp)
    mul $t0, $v0, $t1
    lw $v0, -32($fp)
    lw $t2, -36($fp)
    sub $t1, $v0, $t2
    lw $t2, -40($fp)
    div $v0, $t1, $t2
    add $t1, $t0, $v0
    lw $v0, -20($fp)
    div $t0, $v0, $t1
    lw $t1, -44($fp)
    div $v0, $t0, $t1
    lw $t0, -52($fp)
    lw $t2, -56($fp)
    add $t1, $t0, $t2
    lw $t2, -60($fp)
    sub $t0, $t1, $t2
    lw $t1, -48($fp)
    mul $t2, $t1, $t0
    add $t0, $v0, $t2
    lw $v0, -16($fp)
    mul $t1, $v0, $t0
    lw $v0, -12($fp)
    add $t0, $v0, $t1
    sw $t0, -8($fp)
    l.d $f2, -128($fp)
    l.d $f6, -136($fp)
    div.d $f4, $f2, $f6
    l.d $f2, -120($fp)
    div.d $f6, $f2, $f4
    l.d $f2, -112($fp)
    div.d $f4, $f2, $f6
    l.d $f2, -104($fp)
    div.d $f6, $f2, $f4
    l.d $f2, -96($fp)
    div.d $f4, $f2, $f6
    l.d $f2, -88($fp)
    div.d $f6, $f2, $f4
    l.d $f2, -80($fp)
    div.d $f4, $f2, $f6
    l.d $f2, -72($fp)
    div.d $f6, $f2, $f4
    s.d $f6, -64($fp)
epilogue_main:
    add $sp, $sp, 144  # Increment stack pointer for local variables
    lw $fp, -4($sp)   # Set $fp to $sp-4
    lw $ra, 0($sp)    # Save ra
    jr $ra            # Jump back to the called procedure
# Epilogue Ends

