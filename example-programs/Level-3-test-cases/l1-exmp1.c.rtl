**PROCEDURE: main
**BEGIN: RTL Statements
    iLoad:	v0 <- 5			;; Loading integer number 5
    read				;; This is where syscall will be made
    store:	num1_ <- v0
    iLoad:	v0 <- 5			;; Loading integer number 5
    read				;; This is where syscall will be made
    store:	num2_ <- v0
    load:	v0 <- num1_			;; Loading variable num1_ into register
    load:	t1 <- num2_			;; Loading variable num2_ into register
    sge:	t0 <- v0 , t1
    load:	v0 <- num1_			;; Loading variable num1_ into register
    load:	t2 <- num2_			;; Loading variable num2_ into register
    mul:	t1 <- v0 , t2
    load:	v0 <- num1_			;; Loading variable num1_ into register
    load:	t3 <- num2_			;; Loading variable num2_ into register
    add:	t2 <- v0 , t3
    sgt:	v0 <- t1 , t2
    or:	t1 <- t0 , v0
    not:	v0 <- t1
    bgtz:	v0 , Label0
    load:	v0 <- num1_			;; Loading variable num1_ into register
    store:	stemp0 <- v0
    goto:		Label1
Label0:
    load:	v0 <- num2_			;; Loading variable num2_ into register
    store:	stemp0 <- v0
Label1:
    load:	v0 <- stemp0			;; Loading variable stemp0 into register
    store:	greater_ <- v0
    iLoad:	v0 <- 1			;; Loading integer number 1
    load:	a0 <- greater_			;; Moving the value to be printed into register a0
    write				;; This is where syscall will be made
**END: RTL Statements
