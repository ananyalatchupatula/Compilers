**PROCEDURE: main
**BEGIN: RTL Statements
    iLoad:	v0 <- 4			;; Loading integer number 4
    load_addr:	a0 <- _str_0
    write				;; This is where syscall will be made
    iLoad:	v0 <- 5			;; Loading integer number 5
    read				;; This is where syscall will be made
    store:	a_ <- v0
    iLoad:	v0 <- 4			;; Loading integer number 4
    load_addr:	a0 <- _str_1
    write				;; This is where syscall will be made
    iLoad:	v0 <- 5			;; Loading integer number 5
    read				;; This is where syscall will be made
    store:	b_ <- v0
    iLoad:	v0 <- 4			;; Loading integer number 4
    load_addr:	a0 <- _str_2
    write				;; This is where syscall will be made
    iLoad:	v0 <- 5			;; Loading integer number 5
    read				;; This is where syscall will be made
    store:	c_ <- v0
    load:	v0 <- a_			;; Loading variable a_ into register
    load:	t1 <- b_			;; Loading variable b_ into register
    sgt:	t0 <- v0 , t1
    not:	v0 <- t0
    bgtz:	v0 , Label0
    load:	v0 <- a_			;; Loading variable a_ into register
    load:	t1 <- c_			;; Loading variable c_ into register
    sgt:	t0 <- v0 , t1
    not:	v0 <- t0
    bgtz:	v0 , Label2
    load:	v0 <- a_			;; Loading variable a_ into register
    store:	stemp1 <- v0
    goto:		Label3
Label2:
    load:	v0 <- c_			;; Loading variable c_ into register
    store:	stemp1 <- v0
Label3:
    load:	v0 <- stemp1			;; Loading variable stemp1 into register
    store:	stemp0 <- v0
    goto:		Label1
Label0:
    load:	v0 <- b_			;; Loading variable b_ into register
    load:	t1 <- c_			;; Loading variable c_ into register
    sgt:	t0 <- v0 , t1
    not:	v0 <- t0
    bgtz:	v0 , Label4
    load:	v0 <- b_			;; Loading variable b_ into register
    store:	stemp2 <- v0
    goto:		Label5
Label4:
    load:	v0 <- c_			;; Loading variable c_ into register
    store:	stemp2 <- v0
Label5:
    load:	v0 <- stemp2			;; Loading variable stemp2 into register
    store:	stemp0 <- v0
Label1:
    load:	v0 <- stemp0			;; Loading variable stemp0 into register
    store:	d_ <- v0
    iLoad:	v0 <- 4			;; Loading integer number 4
    load_addr:	a0 <- _str_3
    write				;; This is where syscall will be made
    iLoad:	v0 <- 1			;; Loading integer number 1
    load:	a0 <- d_			;; Moving the value to be printed into register a0
    write				;; This is where syscall will be made
**END: RTL Statements
