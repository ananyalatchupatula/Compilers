.data
_str_0: .asciiz "Enter your percentage "
_str_1: .asciiz "F"
_str_2: .asciiz "D"
_str_3: .asciiz "C"
_str_4: .asciiz "B"
_str_5: .asciiz "A"
_str_6: .asciiz "The grade obtained is: "

.text          # The .text assembler directive indicates
    .globl main      # The following is the code (as opposed to data)
main:                # .globl makes main know to the outside of the program.
# Prologue begins
    sw $ra, 0($sp)    # Save the return address
    sw $fp, -4($sp)   # Save the frame pointer
    sub $fp, $sp, 4   # Update the frame pointer
    sub $sp, $sp, 36  # Make space for the locals
# Prologue ends

    li $v0, 4
    la $a0, _str_0
    syscall
    li $v0, 7
    syscall
    s.d $f0, -8($fp)
    l.d $f2, -8($fp)
    li.d $f4, 40.00
    add $f7, $f2, $f4
    li $v0, 1
    move $t0, $zero
    movt $t0, $v0, 0
    xori $v0, $t0, 1
    bgtz $v0, Label0
    la $v0, _str_1
    sw $v0, -16($fp)
    j Label1
Label0:
    l.d $f2, -8($fp)
    li.d $f4, 40.00
    add $f7, $f2, $f4
    li $v0, 1
    move $t0, $zero
    movf $t0, $v0, 0
    l.d $f2, -8($fp)
    li.d $f4, 50.00
    add $f7, $f2, $f4
    li $v0, 1
    move $t1, $zero
    movt $t1, $v0, 0
    and $v0, $t0, $t1
    xori $t0, $v0, 1
    bgtz $t0, Label2
    la $v0, _str_2
    sw $v0, -20($fp)
    j Label3
Label2:
    l.d $f2, -8($fp)
    li.d $f4, 50.00
    add $f7, $f2, $f4
    li $v0, 1
    move $t0, $zero
    movf $t0, $v0, 0
    l.d $f2, -8($fp)
    li.d $f4, 60.00
    add $f7, $f2, $f4
    li $v0, 1
    move $t1, $zero
    movt $t1, $v0, 0
    and $v0, $t0, $t1
    xori $t0, $v0, 1
    bgtz $t0, Label4
    la $v0, _str_3
    sw $v0, -24($fp)
    j Label5
Label4:
    l.d $f2, -8($fp)
    li.d $f4, 60.00
    add $f7, $f2, $f4
    li $v0, 1
    move $t0, $zero
    movf $t0, $v0, 0
    l.d $f2, -8($fp)
    li.d $f4, 70.00
    add $f7, $f2, $f4
    li $v0, 1
    move $t1, $zero
    movt $t1, $v0, 0
    and $v0, $t0, $t1
    xori $t0, $v0, 1
    bgtz $t0, Label6
    la $v0, _str_4
    sw $v0, -28($fp)
    j Label7
Label6:
    la $v0, _str_5
    sw $v0, -28($fp)
Label7:
    lw $v0, -28($fp)
    sw $v0, -24($fp)
Label5:
    lw $v0, -24($fp)
    sw $v0, -20($fp)
Label3:
    lw $v0, -20($fp)
    sw $v0, -16($fp)
Label1:
    lw $v0, -16($fp)
    sw $v0, -4($fp)
    li $v0, 4
    la $a0, _str_6
    syscall
    li $v0, 4
    lw $a0, -4($fp)
    syscall
epilogue_main:
    add $sp, $sp, 36  # Increment stack pointer for local variables
    lw $fp, -4($sp)   # Set $fp to $sp-4
    lw $ra, 0($sp)    # Save ra
    jr $ra            # Jump back to the called procedure
# Epilogue Ends

