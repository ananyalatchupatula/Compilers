**PROCEDURE: main
**BEGIN: RTL Statements
    iLoad:	v0 <- 5			;; Loading integer number 5
    store:	a_ <- v0
    iLoad:	v0 <- 3			;; Loading integer number 3
    store:	b_ <- v0
    iLoad:	v0 <- 7			;; Loading integer number 7
    read				;; This is where syscall will be made
    store.d:	c_ <- f0
    iLoad:	v0 <- 7			;; Loading integer number 7
    read				;; This is where syscall will be made
    store.d:	d_ <- f0
    load:	v0 <- a_			;; Loading variable a_ into register
    load:	t1 <- b_			;; Loading variable b_ into register
    sgt:	t0 <- v0 , t1
    not:	v0 <- t0
    bgtz:	v0 , Label0
    load.d:	f2 <- c_			;; Loading variable c_ into register
    load.d:	f4 <- d_			;; Loading variable d_ into register
    sle.d:	f2 , f4
    iLoad:	v0 <- 1			;; Loading integer number 1
    move:	t0 <- zero
    movf:	t0 <- v0 , 0
    not:	v0 <- t0
    bgtz:	v0 , Label2
    load:	v0 <- a_			;; Loading variable a_ into register
    load:	t1 <- b_			;; Loading variable b_ into register
    mul:	t0 <- v0 , t1
    store:	stemp1 <- t0
    goto:		Label3
Label2:
    load:	v0 <- a_			;; Loading variable a_ into register
    load:	t1 <- b_			;; Loading variable b_ into register
    sub:	t0 <- v0 , t1
    store:	stemp1 <- t0
Label3:
    load:	v0 <- stemp1			;; Loading variable stemp1 into register
    store:	stemp0 <- v0
    goto:		Label1
Label0:
    load.d:	f2 <- d_			;; Loading variable d_ into register
    load.d:	f4 <- c_			;; Loading variable c_ into register
    sle.d:	f2 , f4
    iLoad:	v0 <- 1			;; Loading integer number 1
    move:	t0 <- zero
    movf:	t0 <- v0 , 0
    not:	v0 <- t0
    bgtz:	v0 , Label4
    load:	v0 <- a_			;; Loading variable a_ into register
    iLoad:	t1 <- 3			;; Loading integer number 3
    add:	t0 <- v0 , t1
    store:	stemp2 <- t0
    goto:		Label5
Label4:
    load:	v0 <- b_			;; Loading variable b_ into register
    iLoad:	t1 <- 10			;; Loading integer number 10
    mul:	t0 <- v0 , t1
    store:	stemp2 <- t0
Label5:
    load:	v0 <- stemp2			;; Loading variable stemp2 into register
    store:	stemp0 <- v0
Label1:
    load:	v0 <- stemp0			;; Loading variable stemp0 into register
    store:	a_ <- v0
    iLoad:	v0 <- 1			;; Loading integer number 1
    load:	a0 <- a_			;; Moving the value to be printed into register a0
    write				;; This is where syscall will be made
**END: RTL Statements
