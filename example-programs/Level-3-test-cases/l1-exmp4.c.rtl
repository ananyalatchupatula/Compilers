**PROCEDURE: main
**BEGIN: RTL Statements
    iLoad:	v0 <- 4			;; Loading integer number 4
    load_addr:	a0 <- _str_0
    write				;; This is where syscall will be made
    iLoad:	v0 <- 5			;; Loading integer number 5
    read				;; This is where syscall will be made
    store:	mrks_ <- v0
    load:	v0 <- mrks_			;; Loading variable mrks_ into register
    iLoad:	t1 <- 40			;; Loading integer number 40
    sge:	t0 <- v0 , t1
    not:	v0 <- t0
    bgtz:	v0 , Label0
    load_addr:	v0 <- _str_1
    store:	stemp0 <- v0
    goto:		Label1
Label0:
    load_addr:	v0 <- _str_2
    store:	stemp0 <- v0
Label1:
    load:	v0 <- stemp0			;; Loading variable stemp0 into register
    store:	res_ <- v0
    iLoad:	v0 <- 4			;; Loading integer number 4
    load:	a0 <- res_			;; Moving the value to be printed into register a0
    write				;; This is where syscall will be made
**END: RTL Statements
