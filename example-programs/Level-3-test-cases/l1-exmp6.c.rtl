**PROCEDURE: main
**BEGIN: RTL Statements
    iLoad:	v0 <- 2			;; Loading integer number 2
    store:	c_ <- v0
    iLoad:	v0 <- 3			;; Loading integer number 3
    store:	b_ <- v0
    load_addr:	v0 <- _str_0
    store:	s_ <- v0
    iLoad.d:	f2 <- 3.50			;; Loading integer number 3.50
    store.d:	z_ <- f2
    iLoad:	v0 <- 1			;; Loading integer number 1
    load:	a0 <- 5			;; Moving the value to be printed into register a0
    write				;; This is where syscall will be made
    iLoad:	v0 <- 3			;; Loading integer number 3
    load.d:	f12 <- 5.60			;; Loading variable 5.60 into register
    write				;; This is where syscall will be made
    iLoad:	v0 <- 4			;; Loading integer number 4
    load_addr:	a0 <- _str_0
    write				;; This is where syscall will be made
    iLoad:	v0 <- 1			;; Loading integer number 1
    load:	a0 <- x_			;; Moving the value to be printed into register a0
    write				;; This is where syscall will be made
    iLoad:	v0 <- 5			;; Loading integer number 5
    read				;; This is where syscall will be made
    store:	b_ <- v0
    load:	v0 <- x_			;; Loading variable x_ into register
    load:	t1 <- b_			;; Loading variable b_ into register
    slt:	t0 <- v0 , t1
    load:	v0 <- b_			;; Loading variable b_ into register
    load:	t2 <- c_			;; Loading variable c_ into register
    sgt:	t1 <- v0 , t2
    load:	v0 <- c_			;; Loading variable c_ into register
    load:	t3 <- b_			;; Loading variable b_ into register
    seq:	t2 <- v0 , t3
    not:	v0 <- t2
    and:	t2 <- t1 , v0
    or:	v0 <- t0 , t2
    not:	t0 <- v0
    bgtz:	t0 , Label0
    load:	v0 <- c_			;; Loading variable c_ into register
    uminus:	t0 <- v0
    load:	t1 <- x_			;; Loading variable x_ into register
    mul:	v0 <- t0 , t1
    load:	t1 <- x_			;; Loading variable x_ into register
    add:	t0 <- v0 , t1
    load:	t1 <- x_			;; Loading variable x_ into register
    add:	v0 <- t0 , t1
    load:	t0 <- c_			;; Loading variable c_ into register
    uminus:	t1 <- t0
    load:	t0 <- b_			;; Loading variable b_ into register
    add:	t2 <- t0 , t1
    load:	t0 <- c_			;; Loading variable c_ into register
    div:	t1 <- t0 , t2
    sub:	t0 <- v0 , t1
    store:	stemp0 <- t0
    goto:		Label1
Label0:
    load:	v0 <- c_			;; Loading variable c_ into register
    iLoad:	t1 <- 20			;; Loading integer number 20
    mul:	t0 <- v0 , t1
    iLoad:	t1 <- 30			;; Loading integer number 30
    sub:	v0 <- t0 , t1
    store:	stemp0 <- v0
Label1:
    load:	v0 <- stemp0			;; Loading variable stemp0 into register
    store:	x_ <- v0
**END: RTL Statements
