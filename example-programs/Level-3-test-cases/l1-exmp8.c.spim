.text          # The .text assembler directive indicates
    .globl main      # The following is the code (as opposed to data)
main:                # .globl makes main know to the outside of the program.
# Prologue begins
    sw $ra, 0($sp)    # Save the return address
    sw $fp, -4($sp)   # Save the frame pointer
    sub $fp, $sp, 4   # Update the frame pointer
    sub $sp, $sp, 32  # Make space for the locals
# Prologue ends

    li.d $f2, 2.30
    s.d $f2, -8($fp)
    li.d $f2, 3.40
    s.d $f2, -16($fp)
    l.d $f2, -8($fp)
    l.d $f6, -16($fp)
    mul.d $f4, $f2, $f6
    l.d $f2, -8($fp)
    add $f7, $f4, $f2
    li $v0, 1
    move $t0, $zero
    movf $t0, $v0, 0
    l.d $f2, -16($fp)
    l.d $f4, -8($fp)
    add $f7, $f2, $f4
    li $v0, 1
    move $t1, $zero
    movt $t1, $v0, 0
    xori $v0, $t1, 1
    or $t1, $t0, $v0
    sw $t1, -24($fp)
epilogue_main:
    add $sp, $sp, 32  # Increment stack pointer for local variables
    lw $fp, -4($sp)   # Set $fp to $sp-4
    lw $ra, 0($sp)    # Save ra
    jr $ra            # Jump back to the called procedure
# Epilogue Ends

