**PROCEDURE: main
**BEGIN: RTL Statements
    iLoad:	v0 <- 5			;; Loading integer number 5
    store:	n_ <- v0
    iLoad:	v0 <- 1			;; Loading integer number 1
    store:	fact_ <- v0
    iLoad:	v0 <- 1			;; Loading integer number 1
    store:	c_ <- v0

Label0:
    load:	v0 <- c_			;; Loading variable c_ into register
    load:	t1 <- n_			;; Loading variable n_ into register
    sle:	t0 <- v0 , t1
    not:	v0 <- t0
    bgtz:	v0 , Label1
    load:	v0 <- fact_			;; Loading variable fact_ into register
    load:	t1 <- c_			;; Loading variable c_ into register
    mul:	t0 <- v0 , t1
    store:	fact_ <- t0
    load:	v0 <- c_			;; Loading variable c_ into register
    iLoad:	t1 <- 1			;; Loading integer number 1
    add:	t0 <- v0 , t1
    store:	c_ <- t0
    goto:		Label0

Label1:
**END: RTL Statements


