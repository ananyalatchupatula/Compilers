**PROCEDURE: main
**BEGIN: RTL Statements
    iLoad:	v0 <- 2			;; Loading integer number 2
    store:	a_ <- v0
    iLoad:	v0 <- 3			;; Loading integer number 3
    store:	b_ <- v0
    iLoad:	v0 <- 4			;; Loading integer number 4
    store:	c_ <- v0
    iLoad:	v0 <- 5			;; Loading integer number 5
    store:	d_ <- v0
    iLoad:	v0 <- 6			;; Loading integer number 6
    store:	e_ <- v0
    load:	f2 <- b_			;; Loading variable b_ into register
    load:	f4 <- c_			;; Loading variable c_ into register
    add.d:	t0 <- f2 , f4
    load:	f2 <- a_			;; Loading variable a_ into register
    sge.d:	t0 <- f2 , t0
    load:	f2 <- e_			;; Loading variable e_ into register
    load:	f4 <- d_			;; Loading variable d_ into register
    mul.d:	t0 <- f2 , f4
    load:	f4 <- c_			;; Loading variable c_ into register
    div.d:	v0 <- t0 , f4
    load:	f2 <- d_			;; Loading variable d_ into register
    sgt.d:	t0 <- f2 , t0
    and:	v0 <- t0 , t0
    not:	v0 <- v0
    bgtz:	v0 , Label1
    load:	f2 <- a_			;; Loading variable a_ into register
    load:	f4 <- d_			;; Loading variable d_ into register
    mul.d:	t0 <- f2 , f4
    load:	f4 <- e_			;; Loading variable e_ into register
    div.d:	v0 <- t0 , f4
    store:	a_ <- v0
    goto:		Label0
Label1:
    load:	f2 <- e_			;; Loading variable e_ into register
    load:	f4 <- d_			;; Loading variable d_ into register
    add.d:	t0 <- f2 , f4
    store:	e_ <- t0
Label0:
**END: RTL Statements
