**PROCEDURE: main
**BEGIN: RTL Statements
    store:	a_ <- 5
    store:	b_ <- 1
Label2:
    load:	v0 <- a_			;; Loading variable a_ into register
    add:	t0 <- v0 , 1
    store:	temp0 <- t0
    store:	a_ <- temp0
    load:	v0 <- b_			;; Loading variable b_ into register
    slt:	t0 <- v0 , 2
    store:	temp1 <- t0
    load:	v0 <- temp1			;; Loading variable temp1 into register
    not:	t0 <- v0
    store:	temp3 <- t0
    load:	v0 <- temp3			;; Loading variable temp3 into register
    bgtz:	v0 , Label1
    load:	v0 <- b_			;; Loading variable b_ into register
    add:	t0 <- v0 , 1
    store:	temp2 <- t0
    store:	b_ <- temp2
    goto:		Label0
Label1:
    load:	v0 <- b_			;; Loading variable b_ into register
    sub:	t0 <- v0 , 1
    store:	temp4 <- t0
    store:	b_ <- temp4
Label0:
    load:	v0 <- a_			;; Loading variable a_ into register
    slt:	t0 <- v0 , 10
    store:	temp5 <- t0
    load:	v0 <- temp5			;; Loading variable temp5 into register
    bgtz:	v0 , Label2
    write:				;; This is where syscall will be made
**END: RTL Statements
