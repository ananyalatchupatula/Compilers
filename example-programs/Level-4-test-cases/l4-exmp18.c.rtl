**PROCEDURE: main
**BEGIN: RTL Statements
    iLoad:	v0 <- 0			;; Loading integer number 0
    store:	max_ <- v0
    iLoad:	v0 <- 5			;; Loading integer number 5
    store:	a_ <- v0
    iLoad:	v0 <- 1			;; Loading 1 in v0 to indicate syscall to print integter value
    store:	b_ <- v0
    load:	v0 <- a_			;; Loading variable a_ into register
    load:	t1 <- max_			;; Loading variable max_ into register
    sgt:	t0 <- v0 , t1
    not:	v0 <- t0
    bgtz:	v0 , Label1
    load:	v0 <- a_			;; Loading variable a_ into register
    store:	max_ <- v0
    goto:		Label0
Label1:
    load:	v0 <- b_			;; Loading variable b_ into register
    load:	t1 <- max_			;; Loading variable max_ into register
    sgt:	t0 <- v0 , t1
    not:	v0 <- t0
    bgtz:	v0 , Label3
    load:	v0 <- b_			;; Loading variable b_ into register
    store:	max_ <- v0
    goto:		Label2
Label3:
    load:	v0 <- c_			;; Loading variable c_ into register
    load:	t1 <- max_			;; Loading variable max_ into register
    sgt:	t0 <- v0 , t1
    not:	v0 <- t0
    bgtz:	v0 , Label4
    load:	v0 <- c_			;; Loading variable c_ into register
    store:	max_ <- v0
    goto:		Label4
Label4:
Label2:
Label0:
    iLoad:	v0 <- 2			;; Loading integer number 2
    store:	c_ <- v0
**END: RTL Statements
