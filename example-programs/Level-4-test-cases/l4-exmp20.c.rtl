**PROCEDURE: main
**BEGIN: RTL Statements
    store:	a_ <- 5
    store:	b_ <- 1
Label2:
    load:	v0 <- a_			;; Loading variable a_ into register
    slt:	t0 <- v0 , 10
    store:	temp0 <- t0
    load:	v0 <- temp0			;; Loading variable temp0 into register
    not:	t0 <- v0
    store:	temp5 <- t0
    load:	v0 <- temp5			;; Loading variable temp5 into register
    bgtz:	v0 , Label3
    load:	v0 <- a_			;; Loading variable a_ into register
    add:	t0 <- v0 , 1
    store:	temp1 <- t0
    store:	a_ <- temp1
Label0:
    load:	v0 <- b_			;; Loading variable b_ into register
    slt:	t0 <- v0 , 5
    store:	temp2 <- t0
    load:	v0 <- temp2			;; Loading variable temp2 into register
    not:	t0 <- v0
    store:	temp4 <- t0
    load:	v0 <- temp4			;; Loading variable temp4 into register
    bgtz:	v0 , Label1
    load:	v0 <- b_			;; Loading variable b_ into register
    add:	t0 <- v0 , 1
    store:	temp3 <- t0
    store:	b_ <- temp3
    store:	a_ <- 2
    goto:		Label0
Label1:
    goto:		Label2
Label3:
**END: RTL Statements
