**PROCEDURE: main
**BEGIN: RTL Statements
Label2:
Label0:
    load:	v0 <- i_			;; Loading variable i_ into register
    sgt:	t0 <- v0 , 10
    store:	temp0 <- t0
    load:	v0 <- temp0			;; Loading variable temp0 into register
    not:	t0 <- v0
    store:	temp2 <- t0
    load:	v0 <- temp2			;; Loading variable temp2 into register
    bgtz:	v0 , Label1
    load:	v0 <- i_			;; Loading variable i_ into register
    add:	t0 <- v0 , 1
    store:	temp1 <- t0
    store:	i_ <- temp1
    goto:		Label0
Label1:
    load:	v0 <- x_			;; Loading variable x_ into register
    bgtz:	v0 , Label2
    load:	v0 <- i_			;; Loading variable i_ into register
    sub:	t0 <- v0 , 3
    store:	temp3 <- t0
    store:	i_ <- temp3
**END: RTL Statements
