**PROCEDURE: main
**BEGIN: RTL Statements
    store:	a_ <- 2.30
    store:	b_ <- 3.40
    load:	v0 <- a_			;; Loading variable a_ into register
    add:	t0 <- v0 , b_
    store:	temp0 <- t0
    load:	v0 <- a_			;; Loading variable a_ into register
    sub:	t0 <- v0 , b_
    store:	temp1 <- t0
    load:	v0 <- temp0			;; Loading variable temp0 into register
    slt:	t0 <- v0 , temp1
    store:	temp2 <- t0
    load:	v0 <- temp2			;; Loading variable temp2 into register
    not:	t0 <- v0
    store:	temp5 <- t0
    load:	v0 <- temp5			;; Loading variable temp5 into register
    bgtz:	v0 , Label0
    load:	v0 <- a_			;; Loading variable a_ into register
    mul:	t0 <- v0 , b_
    store:	temp3 <- t0
    store:	stemp0 <- temp3
    goto:		Label1
Label0:
    load:	v0 <- a_			;; Loading variable a_ into register
    sub:	t0 <- v0 , b_
    store:	temp4 <- t0
    store:	stemp0 <- temp4
Label1:
    store:	d_ <- stemp0
**END: RTL Statements
