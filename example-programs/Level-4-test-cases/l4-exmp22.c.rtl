**PROCEDURE: main
**BEGIN: RTL Statements
    iLoad:	v0 <- 0			;; Loading integer number 0
    store:	a_ <- v0
    iLoad:	v0 <- 0			;; Loading integer number 0
    store:	b_ <- v0
    load:	v0 <- a_			;; Loading variable a_ into register
    load:	t1 <- b_			;; Loading variable b_ into register
    add:	t0 <- v0 , t1
    load:	v0 <- a_			;; Loading variable a_ into register
    load:	t2 <- b_			;; Loading variable b_ into register
    sub:	t1 <- v0 , t2
    slt:	v0 <- t0 , t1
    not:	t0 <- v0
    bgtz:	t0 , Label0
    load:	v0 <- a_			;; Loading variable a_ into register
    load:	t1 <- b_			;; Loading variable b_ into register
    mul:	t0 <- v0 , t1
    store:	stemp0 <- t0
    goto:		Label1
Label0:
    load:	v0 <- a_			;; Loading variable a_ into register
    load:	t1 <- b_			;; Loading variable b_ into register
    sub:	t0 <- v0 , t1
    store:	stemp0 <- t0
Label1:
    load:	v0 <- stemp0			;; Loading variable stemp0 into register
    store:	d_ <- v0
**END: RTL Statements
