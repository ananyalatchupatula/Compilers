**PROCEDURE: main
**BEGIN: RTL Statements
    iLoad:	v0 <- 2			;; Loading integer number 2
    store:	a_ <- v0
    iLoad:	v0 <- 3			;; Loading integer number 3
    store:	b_ <- v0
    load:	f2 <- a_			;; Loading variable a_ into register
    load:	f4 <- b_			;; Loading variable b_ into register
    add.d:	t0 <- f2 , f4
    load:	f2 <- a_			;; Loading variable a_ into register
    load:	f4 <- b_			;; Loading variable b_ into register
    sub.d:	t0 <- f2 , f4
    slt:	t0 <- t0 , t0
    not:	v0 <- t0
    bgtz:	v0 , Label0
    load:	f2 <- a_			;; Loading variable a_ into register
    load:	f4 <- b_			;; Loading variable b_ into register
    mul.d:	t0 <- f2 , f4
    store:	stemp0 <- t0
    goto:		Label1
Label0:
    load:	f2 <- a_			;; Loading variable a_ into register
    load:	f4 <- b_			;; Loading variable b_ into register
    sub.d:	t0 <- f2 , f4
    store:	stemp0 <- t0
Label1:
    load:	v0 <- stemp0			;; Loading variable stemp0 into register
    store:	d_ <- v0
**END: RTL Statements
