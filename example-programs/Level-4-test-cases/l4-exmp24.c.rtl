**PROCEDURE: main
**BEGIN: RTL Statements
    iLoad:	v0 <- 2			;; Loading integer number 2
    store:	a_ <- v0
    iLoad:	v0 <- 3			;; Loading integer number 3
    store:	b_ <- v0
    iLoad:	v0 <- 4			;; Loading integer number 4
    store:	c_ <- v0
    load:	v0 <- b_			;; Loading variable b_ into register
    load:	t1 <- a_			;; Loading variable a_ into register
    sgt:	t0 <- v0 , t1
    not:	v0 <- t0
    bgtz:	v0 , Label2
    load:	v0 <- b_			;; Loading variable b_ into register
    load:	t1 <- c_			;; Loading variable c_ into register
    sgt:	t0 <- v0 , t1
    not:	v0 <- t0
    bgtz:	v0 , Label0
    load:	v0 <- b_			;; Loading variable b_ into register
    store:	stemp0 <- v0
    goto:		Label1
Label0:
    load:	v0 <- c_			;; Loading variable c_ into register
    store:	stemp0 <- v0
Label1:
    load:	v0 <- stemp0			;; Loading variable stemp0 into register
    store:	a_ <- v0
    goto:		Label2
Label2:
    iLoad:	v0 <- 1			;; Loading 1 in v0 to indicate syscall to print integter value
    load:	a0 <- a_			;; Moving the value to be printed into register a0
    write				;; This is where syscall will be made
**END: RTL Statements
