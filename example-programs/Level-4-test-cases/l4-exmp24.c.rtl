**PROCEDURE: main
**BEGIN: RTL Statements
    store:	a_ <- 2
    store:	b_ <- 3
    store:	c_ <- 4
    load:	v0 <- b_			;; Loading variable b_ into register
    sgt:	t0 <- v0 , a_
    store:	temp0 <- t0
    load:	v0 <- temp0			;; Loading variable temp0 into register
    not:	t0 <- v0
    store:	temp3 <- t0
    load:	v0 <- temp3			;; Loading variable temp3 into register
    bgtz:	v0 , Label1
    load:	v0 <- b_			;; Loading variable b_ into register
    sgt:	t0 <- v0 , c_
    store:	temp1 <- t0
    load:	v0 <- temp1			;; Loading variable temp1 into register
    not:	t0 <- v0
    store:	temp2 <- t0
    load:	v0 <- temp2			;; Loading variable temp2 into register
    bgtz:	v0 , Label2
    store:	stemp0 <- b_
    goto:		Label3
Label2:
    store:	stemp0 <- c_
Label3:
    store:	a_ <- stemp0
    goto:		Label0
Label1:
Label0:
    write:				;; This is where syscall will be made
**END: RTL Statements
