**PROCEDURE: main
**BEGIN: RTL Statements
    store:	maxInput_ <- 10
    store:	sum_ <- 0
    store:	i_ <- 2
    store:	number_ <- 2
Label0:
    load:	v0 <- i_			;; Loading variable i_ into register
    slt:	t0 <- v0 , maxInput_
    store:	temp0 <- t0
    load:	v0 <- temp0			;; Loading variable temp0 into register
    not:	t0 <- v0
    store:	temp2 <- t0
    load:	v0 <- temp2			;; Loading variable temp2 into register
    bgtz:	v0 , Label1
    write:				;; This is where syscall will be made
    load:	v0 <- i_			;; Loading variable i_ into register
    add:	t0 <- v0 , 2
    store:	temp1 <- t0
    store:	i_ <- temp1
    goto:		Label0
Label1:
    load:	v0 <- number_			;; Loading variable number_ into register
    slt:	t0 <- v0 , 3
    store:	temp3 <- t0
    load:	v0 <- temp3			;; Loading variable temp3 into register
    not:	t0 <- v0
    store:	temp4 <- t0
    load:	v0 <- temp4			;; Loading variable temp4 into register
    bgtz:	v0 , Label3
    store:	number_ <- 5
    goto:		Label2
Label3:
Label2:
    load:	v0 <- sum_			;; Loading variable sum_ into register
    add:	t0 <- v0 , number_
    store:	temp5 <- t0
    store:	sum_ <- temp5
    write:				;; This is where syscall will be made
**END: RTL Statements
