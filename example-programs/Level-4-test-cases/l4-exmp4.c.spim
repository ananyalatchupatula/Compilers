.data
_str_0: .asciiz " "
_str_1: .asciiz "Your number is: "

.text          # The .text assembler directive indicates
    .globl main      # The following is the code (as opposed to data)
main:                # .globl makes main know to the outside of the program.
# Prologue begins
    sw $ra, 0($sp)    # Save the return address
    sw $fp, -4($sp)   # Save the frame pointer
    sub $fp, $sp, 4   # Update the frame pointer
    sub $sp, $sp, 12  # Make space for the locals
# Prologue ends

    li $v0, 5
    syscall
    sw $v0, -4($fp)
    lw $v0, -4($fp)
    li $t1, 5
    sge $t0, $v0, $t1
    lw $v0, -4($fp)
    li $t2, 10
    sle $t1, $v0, $t2
    and $v0, $t0, $t1
    xori $t0, $v0, 1
    bgtz $t0, Label3
Label0:
    lw $v0, -4($fp)
    li $t1, 0
    sgt $t0, $v0, $t1
    xori $v0, $t0, 1
    bgtz $v0, Label1
    li $v0, 1
    lw $a0, -4($fp)
    syscall
    li $v0, 4
    la $a0, _str_0
    syscall
    lw $v0, -4($fp)
    li $t1, 1
    sub $t0, $v0, $t1
    sw $t0, -4($fp)
    j Label0
Label1:
    j Label2
Label3:
    lw $v0, -4($fp)
    li $t1, 1024
    sle $t0, $v0, $t1
    li $v0, 1024
    lw $v0, -4($fp)
    sge $t2, $v0, $t1
    and $v0, $t0, $t2
    xori $t0, $v0, 1
    bgtz $t0, Label6
Label4:
    li $v0, 1
    lw $a0, -4($fp)
    syscall
    li $v0, 4
    la $a0, _str_0
    syscall
    lw $v0, -4($fp)
    li $t1, 2
    div $t0, $v0, $t1
    sw $t0, -4($fp)
    lw $v0, -4($fp)
    li $t1, 0
    sne $t0, $v0, $t1
    bgtz $t0, Label4
    j Label5
Label6:
    li $v0, 4
    la $a0, _str_1
    syscall
    li $v0, 1
    lw $a0, -4($fp)
    syscall
Label5:
Label2:
epilogue_main:
    add $sp, $sp, 12  # Increment stack pointer for local variables
    lw $fp, -4($sp)   # Set $fp to $sp-4
    lw $ra, 0($sp)    # Save ra
    jr $ra            # Jump back to the called procedure
# Epilogue Ends

