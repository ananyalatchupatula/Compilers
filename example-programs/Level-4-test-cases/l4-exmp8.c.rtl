**PROCEDURE: main
**BEGIN: RTL Statements
    iLoad:	v0 <- 1			;; Loading 1 in v0 to indicate syscall to print integter value
    store:	a1_ <- v0
    iLoad:	v0 <- 1			;; Loading 1 in v0 to indicate syscall to print integter value
    store:	a2_ <- v0
    iLoad:	v0 <- 1			;; Loading 1 in v0 to indicate syscall to print integter value
    store:	a_ <- v0
    iLoad:	v0 <- 1			;; Loading 1 in v0 to indicate syscall to print integter value
    store:	b_ <- v0
    iLoad:	v0 <- 1			;; Loading 1 in v0 to indicate syscall to print integter value
    store:	c_ <- v0
    iLoad:	v0 <- 1			;; Loading 1 in v0 to indicate syscall to print integter value
    store:	d_ <- v0
Label7:
    load:	v0 <- a1_			;; Loading variable a1_ into register
    iLoad:	t1 <- 100			;; Loading integer number 100
    sle:	t0 <- v0 , t1
    not:	v0 <- t0
    bgtz:	v0 , Label8
    load:	v0 <- a_			;; Loading variable a_ into register
    iLoad:	t1 <- 1			;; Loading integer number 1
    add:	t0 <- v0 , t1
    store:	a_ <- t0
    iLoad:	v0 <- 2			;; Loading integer number 2
    iLoad:	t1 <- 3			;; Loading integer number 3
    sge:	t0 <- v0 , t1
    not:	v0 <- t0
    bgtz:	v0 , Label0
    load:	v0 <- a_			;; Loading variable a_ into register
    iLoad:	t1 <- 1			;; Loading integer number 1
    add:	t0 <- v0 , t1
    store:	a_ <- t0
    goto:		Label0
Label0:
    iLoad:	v0 <- 3			;; Loading integer number 3
    iLoad:	t1 <- 2			;; Loading integer number 2
    sge:	t0 <- v0 , t1
    not:	v0 <- t0
    bgtz:	v0 , Label1
    load:	v0 <- a_			;; Loading variable a_ into register
    iLoad:	t1 <- 1			;; Loading integer number 1
    add:	t0 <- v0 , t1
    store:	a_ <- t0
    goto:		Label1
Label1:
    iLoad:	v0 <- 2			;; Loading integer number 2
    iLoad:	t1 <- 3			;; Loading integer number 3
    sle:	t0 <- v0 , t1
    not:	v0 <- t0
    bgtz:	v0 , Label2
    load:	v0 <- a_			;; Loading variable a_ into register
    iLoad:	t1 <- 1			;; Loading integer number 1
    add:	t0 <- v0 , t1
    store:	a_ <- t0
    goto:		Label2
Label2:
    iLoad:	v0 <- 2			;; Loading integer number 2
    iLoad:	t1 <- 3			;; Loading integer number 3
    sne:	t0 <- v0 , t1
    not:	v0 <- t0
    bgtz:	v0 , Label3
    load:	v0 <- a_			;; Loading variable a_ into register
    iLoad:	t1 <- 1			;; Loading integer number 1
    add:	t0 <- v0 , t1
    store:	a_ <- t0
    goto:		Label3
Label3:
    iLoad:	v0 <- 2			;; Loading integer number 2
    iLoad:	t1 <- 3			;; Loading integer number 3
    seq:	t0 <- v0 , t1
    not:	v0 <- t0
    bgtz:	v0 , Label4
    load:	v0 <- a_			;; Loading variable a_ into register
    iLoad:	t1 <- 1			;; Loading integer number 1
    add:	t0 <- v0 , t1
    store:	a_ <- t0
    goto:		Label4
Label4:
    iLoad:	v0 <- 4			;; Loading integer number 4
    iLoad:	t1 <- 3			;; Loading integer number 3
    sge:	t0 <- v0 , t1
    not:	v0 <- t0
    bgtz:	v0 , Label5
    load:	v0 <- a_			;; Loading variable a_ into register
    iLoad:	t1 <- 1			;; Loading integer number 1
    add:	t0 <- v0 , t1
    store:	a_ <- t0
    goto:		Label5
Label5:
Label6:
    load:	v0 <- a1_			;; Loading variable a1_ into register
    iLoad:	t1 <- 1			;; Loading integer number 1
    add:	t0 <- v0 , t1
    store:	a1_ <- t0
    load:	v0 <- a1_			;; Loading variable a1_ into register
    iLoad:	t1 <- 200			;; Loading integer number 200
    sle:	t0 <- v0 , t1
    bgtz:	t0 , Label6
    iLoad:	v0 <- 1			;; Loading 1 in v0 to indicate syscall to print integter value
    load:	a0 <- a1_			;; Moving the value to be printed into register a0
    write				;; This is where syscall will be made
    goto:		Label7
Label8:
    iLoad:	v0 <- 1			;; Loading 1 in v0 to indicate syscall to print integter value
    load:	a0 <- a_			;; Moving the value to be printed into register a0
    write				;; This is where syscall will be made
**END: RTL Statements
