.data
a_: .word 0
b_: .word 0

.text          # The .text assembler directive indicates
    .globl main      # The following is the code (as opposed to data)
main:                # .globl makes main know to the outside of the program.
# Prologue begins
    sw $ra, 0($sp)    # Save the return address
    sw $fp, -4($sp)   # Save the frame pointer
    sub $fp, $sp, 4   # Update the frame pointer
    sub $sp, $sp, 24  # Make space for the locals
# Prologue ends

    li $v0, 1
    sw $v0, -4($fp)
    li $v0, 1
    sw $v0, -8($fp)
    li $v0, 1
    sw $v0, a_
    li $v0, 1
    sw $v0, b_
    li $v0, 1
    sw $v0, -12($fp)
    li $v0, 1
    sw $v0, -16($fp)
Label7:
    lw $v0, -4($fp)
    li $t1, 100
    sle $t0, $v0, $t1
    xori $v0, $t0, 1
    bgtz $v0, Label8
    lw $v0, a_
    li $t1, 1
    add $t0, $v0, $t1
    sw $t0, a_
    li $v0, 2
    li $t1, 3
    sge $t0, $v0, $t1
    xori $v0, $t0, 1
    bgtz $v0, Label0
    lw $v0, a_
    li $t1, 1
    add $t0, $v0, $t1
    sw $t0, a_
    j Label0
Label0:
    li $v0, 3
    li $t1, 2
    sge $t0, $v0, $t1
    xori $v0, $t0, 1
    bgtz $v0, Label1
    lw $v0, a_
    li $t1, 1
    add $t0, $v0, $t1
    sw $t0, a_
    j Label1
Label1:
    li $v0, 2
    li $t1, 3
    sle $t0, $v0, $t1
    xori $v0, $t0, 1
    bgtz $v0, Label2
    lw $v0, a_
    li $t1, 1
    add $t0, $v0, $t1
    sw $t0, a_
    j Label2
Label2:
    li $v0, 2
    li $t1, 3
    sne $t0, $v0, $t1
    xori $v0, $t0, 1
    bgtz $v0, Label3
    lw $v0, a_
    li $t1, 1
    add $t0, $v0, $t1
    sw $t0, a_
    j Label3
Label3:
    li $v0, 2
    li $t1, 3
    seq $t0, $v0, $t1
    xori $v0, $t0, 1
    bgtz $v0, Label4
    lw $v0, a_
    li $t1, 1
    add $t0, $v0, $t1
    sw $t0, a_
    j Label4
Label4:
    li $v0, 4
    li $t1, 3
    sge $t0, $v0, $t1
    xori $v0, $t0, 1
    bgtz $v0, Label5
    lw $v0, a_
    li $t1, 1
    add $t0, $v0, $t1
    sw $t0, a_
    j Label5
Label5:
Label6:
    lw $v0, -4($fp)
    li $t1, 1
    add $t0, $v0, $t1
    sw $t0, -4($fp)
    lw $v0, -4($fp)
    li $t1, 200
    sle $t0, $v0, $t1
    bgtz $t0, Label6
    li $v0, 1
    lw $a0, -4($fp)
    syscall
    j Label7
Label8:
    li $v0, 1
    lw $a0, a_
    syscall
epilogue_main:
    add $sp, $sp, 24  # Increment stack pointer for local variables
    lw $fp, -4($sp)   # Set $fp to $sp-4
    lw $ra, 0($sp)    # Save ra
    jr $ra            # Jump back to the called procedure
# Epilogue Ends

