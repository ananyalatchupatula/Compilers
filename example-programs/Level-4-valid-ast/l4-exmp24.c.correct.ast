**PROCEDURE: main
  Return Type: <void>
  Formal Parameters:
**BEGIN: Abstract Syntax Tree
    Asgn:
      LHS (Name : a_<int>)
      RHS (Num : 2<int>)
    Asgn:
      LHS (Name : b_<int>)
      RHS (Num : 3<int>)
    Asgn:
      LHS (Name : c_<int>)
      RHS (Num : 4<int>)
    If:
      Condition (
        Condition: GT<bool>
          L_Opd (Name : b_<int>)
          R_Opd (Name : a_<int>))
