**PROCEDURE: p_
  Return Type: <int>
  Formal Parameters:
    k_  Type:<int>
**BEGIN: Abstract Syntax Tree
    If:
      Condition (
        Condition: LT<bool>
          L_Opd (Name : k_<int>)
          R_Opd (Num : 0<int>))
      Then (
        Return: Num : 1<int>)
    If:
      Condition (
        Condition: LT<bool>
          L_Opd (Num : 1<int>)
          R_Opd (Num : 2<int>))
      Then (
        Asgn:
          LHS (Name : b_<int>)
          RHS (
            FN CALL: p_(
              Arith: Minus<int>
                L_Opd (Name : k_<int>)
                R_Opd (Num : 1<int>)))
        Asgn:
          LHS (Name : a_<int>)
          RHS (
            Arith: Mult<int>
              L_Opd (Name : a_<int>)
              R_Opd (Name : b_<int>)))
      Else (
        If:
          Condition (
            Condition: LT<bool>
              L_Opd (Num : 1<int>)
              R_Opd (Num : 4<int>))
          Then (
            Asgn:
              LHS (Name : c_<int>)
