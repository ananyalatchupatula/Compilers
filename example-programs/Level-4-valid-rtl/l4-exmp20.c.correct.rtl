**PROCEDURE: main
**BEGIN: RTL Statements
    iLoad:      v0 <- 5             ;; Loading integer number 5
    store:      a_ <- v0
    iLoad:      v0 <- 1             ;; Loading integer number 1
    store:      b_ <- v0

Label2:
    load:       v0 <- a_            ;; Loading variable a_ into register
    iLoad:      t1 <- 10            ;; Loading integer number 10
    slt:        t0 <- v0 , t1
    not:        v0 <- t0
    bgtz:       v0 , Label3
    load:       v0 <- a_            ;; Loading variable a_ into register
    iLoad:      t1 <- 1             ;; Loading integer number 1
    add:        t0 <- v0 , t1
    store:      a_ <- t0

Label0:
    load:       v0 <- b_            ;; Loading variable b_ into register
    iLoad:      t1 <- 5             ;; Loading integer number 5
    slt:        t0 <- v0 , t1
    not:        v0 <- t0
    bgtz:       v0 , Label1
    load:       v0 <- b_            ;; Loading variable b_ into register
    iLoad:      t1 <- 1             ;; Loading integer number 1
    add:        t0 <- v0 , t1
    store:      b_ <- t0
    iLoad:      v0 <- 2             ;; Loading integer number 2
    store:      a_ <- v0
    goto:       Label0

Label1:
    goto:       Label2

Label3:
**END: RTL Statements