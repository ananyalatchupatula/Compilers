**PROCEDURE: main
**BEGIN: RTL Statements

Label2:

Label0:
    load:       v0 <- i_            ;; Loading variable i_ into register
    iLoad:      t1 <- 10            ;; Loading integer number 10
    sgt:        t0 <- v0 , t1
    not:        v0 <- t0
    bgtz:       v0 , Label1
    load:       v0 <- i_            ;; Loading variable i_ into register
    iLoad:      t1 <- 1             ;; Loading integer number 1
    add:        t0 <- v0 , t1
    store:      i_ <- t0
    goto:       Label0

Label1:
    load:       v0 <- x_            ;; Loading variable x_ into register
    bgtz:       v0 , Label2
    load:       v0 <- i_            ;; Loading variable i_ into register
    iLoad:      t1 <- 3             ;; Loading integer number 3
    sub:        t0 <- v0 , t1
    store:      i_ <- t0
**END: RTL Statements