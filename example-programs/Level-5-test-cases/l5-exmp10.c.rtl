**PROCEDURE: f1_
**BEGIN: RTL Statements
    load:	v0 <- b_			;; Loading variable b_ into register
    load:	t1 <- c_			;; Loading variable c_ into register
    add:	t0 <- v0 , t1
    store:	d_ <- t0
    call h_
    load:	v0 <- d_			;; Loading variable d_ into register
    iLoad:	t1 <- 2			;; Loading integer number 2
    add:	t0 <- v0 , t1
    store:	stemp0 <- t0
    goto:		Label0

Label0:
    load:	v1 <- stemp0			;; Loading variable stemp0 into register
    return      v1
**END: RTL Statements


**PROCEDURE: g_
**BEGIN: RTL Statements
    call h_
    iLoad:	v0 <- 1			;; Loading integer number 1
    store:	b_ <- v0
    load:	v0 <- b_			;; Loading variable b_ into register
    push:      v0		;; Push parameter onto stack
    load:	v0 <- b_			;; Loading variable b_ into register
    push:      v0		;; Push parameter onto stack
    v1 = call f1_
    pop				;; Pop parameter from stack
    pop				;; Pop parameter from stack
    move:      v0 <- v1
    store:	b_ <- v0
    load:	v0 <- b_			;; Loading variable b_ into register
    store:	stemp0 <- v0
    goto:		Label1

Label1:
    load:	v1 <- stemp0			;; Loading variable stemp0 into register
    return      v1
**END: RTL Statements


**PROCEDURE: h_
**BEGIN: RTL Statements
    iLoad:	v0 <- 1			;; Loading integer number 1
    store:	c_ <- v0
**END: RTL Statements


**PROCEDURE: main
**BEGIN: RTL Statements
    iLoad:	v0 <- 3			;; Loading integer number 3
    store:	a_ <- v0
    call h_
    load:	v0 <- a_			;; Loading variable a_ into register
    push:      v0		;; Push parameter onto stack
    load:	v0 <- a_			;; Loading variable a_ into register
    push:      v0		;; Push parameter onto stack
    v1 = call f1_
    pop				;; Pop parameter from stack
    pop				;; Pop parameter from stack
    move:      v0 <- v1
    store:	a_ <- v0
    v1 = call g_
    move:      v0 <- v1
    store:	b_ <- v0
    call h_
    load:	v0 <- a_			;; Loading variable a_ into register
    push:      v0		;; Push parameter onto stack
    load:	v0 <- a_			;; Loading variable a_ into register
    push:      v0		;; Push parameter onto stack
    v1 = call f1_
    pop				;; Pop parameter from stack
    pop				;; Pop parameter from stack
    move:      v0 <- v1
    store:	a_ <- v0
    v1 = call g_
    move:      v0 <- v1
    store:	b_ <- v0
    iLoad:	v0 <- 1			;; Loading integer number 1
    load:	a0 <- a_			;; Moving the value to be printed into register a0
    write				;; This is where syscall will be made
**END: RTL Statements


