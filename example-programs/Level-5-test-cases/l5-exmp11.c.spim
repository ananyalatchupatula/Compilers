.data
_str_0: .asciiz "Input temperature in centigrade"
_str_1: .asciiz "Temperature in fahrenheit is "

.text          # The .text assembler directive indicates
    .globl convert_centigrade_to_fahrenheit_      # The following is the code (as opposed to data)
convert_centigrade_to_fahrenheit_:                # .globl makes main know to the outside of the program.
# Prologue begins
    sw $ra, 0($sp)    # Save the return address
    sw $fp, -4($sp)   # Save the frame pointer
    sub $fp, $sp, 4   # Update the frame pointer
    sub $sp, $sp, 32  # Make space for the locals
# Prologue ends

    l.d $f2, 8($fp)
    li.d $f4, 0.00
    c.eq.d $f2, $f4
    li $v0, 1
    movt $t0, $v0, 0
    xori $v0, $t0, 1
    bgtz $v0, Label1
    li.d $f2, 0.00
    s.d $f2, -8($fp)
    j Label2
Label1:
    l.d $f2, 8($fp)
    li.d $f6, 9.00
    mul.d $f4, $f2, $f6
    li.d $f6, 5.00
    div.d $f2, $f4, $f6
    li.d $f6, 32.00
    add.d $f4, $f2, $f6
    s.d $f4, -8($fp)
Label2:
    l.d $f2, -8($fp)
    s.d $f2, -16($fp)
    l.d $f2, -16($fp)
    s.d $f2, -24($fp)
    j Label0
Label0:
    l.d $f0, -24($fp)
    j epilogue_convert_centigrade_to_fahrenheit_
epilogue_convert_centigrade_to_fahrenheit_:
    add $sp, $sp, 32  # Increment stack pointer for local variables
    lw $fp, -4($sp)   # Set $fp to $sp-4
    lw $ra, 0($sp)    # Save ra
    jr $ra            # Jump back to the called procedure
# Epilogue Ends

.text          # The .text assembler directive indicates
    .globl main      # The following is the code (as opposed to data)
main:                # .globl makes main know to the outside of the program.
# Prologue begins
    sw $ra, 0($sp)    # Save the return address
    sw $fp, -4($sp)   # Save the frame pointer
    sub $fp, $sp, 4   # Update the frame pointer
    sub $sp, $sp, 24  # Make space for the locals
# Prologue ends

    li $v0, 4
    la $a0, _str_0
    syscall
    li $v0, 7
    syscall
    s.d $f0, -8($fp)
    l.d $f2, -8($fp)
    s.d $f2, -4($sp)
    sub $sp, $sp, 8
    jal convert_centigrade_to_fahrenheit_
    add $sp, $sp, 8
    mov.d $f2, $f0
    s.d $f2, -16($fp)
    li $v0, 4
    la $a0, _str_1
    syscall
    li $v0, 3
    l.d $f12, -16($fp)
    syscall
epilogue_main:
    add $sp, $sp, 24  # Increment stack pointer for local variables
    lw $fp, -4($sp)   # Set $fp to $sp-4
    lw $ra, 0($sp)    # Save ra
    jr $ra            # Jump back to the called procedure
# Epilogue Ends

