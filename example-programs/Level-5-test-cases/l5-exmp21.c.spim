.text          # The .text assembler directive indicates
    .globl A_      # The following is the code (as opposed to data)
A_:                # .globl makes main know to the outside of the program.
# Prologue begins
    sw $ra, 0($sp)    # Save the return address
    sw $fp, -4($sp)   # Save the frame pointer
    sub $fp, $sp, 4   # Update the frame pointer
    sub $sp, $sp, 12  # Make space for the locals
# Prologue ends

        load:	v0 <- i_			;; Loading variable i_ into register
        iLoad:	t1 <- 0			;; Loading integer number 0
        sle:	t0 <- v0 , t1
        load:	v0 <- j_			;; Loading variable j_ into register
        iLoad:	t2 <- 0			;; Loading integer number 0
        sle:	t1 <- v0 , t2
        or:	v0 <- t0 , t1
        not:	t0 <- v0
        bgtz:	t0 , Label1
        iLoad:	v0 <- 1			;; Loading integer number 1
        store:	stemp0 <- v0
        goto:		Label0
        goto:		Label1
    
Label1:
        load:	v0 <- i_			;; Loading variable i_ into register
        iLoad:	t1 <- 1			;; Loading integer number 1
        sub:	t0 <- v0 , t1
        load:	v0 <- j_			;; Loading variable j_ into register
        push:      v0		;; Push parameter onto stack
        push:      t0		;; Push parameter onto stack
        v1 = call A_
        pop				;; Pop parameter from stack
        pop				;; Pop parameter from stack
        move:      v0 <- v1
        store:	x_ <- v0
        load:	v0 <- x_			;; Loading variable x_ into register
        store:	stemp0 <- v0
        goto:		Label0
    
Label0:
        load:	v1 <- stemp0			;; Loading variable stemp0 into register
        return      v1
epilogue_A_:
    add $sp, $sp, 12  # Increment stack pointer for local variables
    lw $fp, -4($sp)   # Set $fp to $sp-4
    lw $ra, 0($sp)    # Save ra
    jr $ra            # Jump back to the called procedure
# Epilogue Ends

.text          # The .text assembler directive indicates
    .globl p_      # The following is the code (as opposed to data)
p_:                # .globl makes main know to the outside of the program.
# Prologue begins
    sw $ra, 0($sp)    # Save the return address
    sw $fp, -4($sp)   # Save the frame pointer
    sub $fp, $sp, 4   # Update the frame pointer
    sub $sp, $sp, 12  # Make space for the locals
# Prologue ends

    
Label2:
        load:	v0 <- a_			;; Loading variable a_ into register
        load:	t1 <- b_			;; Loading variable b_ into register
        sgt:	t0 <- v0 , t1
        not:	v0 <- t0
        bgtz:	v0 , Label3
        iLoad:	v0 <- 3			;; Loading integer number 3
        push:      v0		;; Push parameter onto stack
        iLoad:	v0 <- 3			;; Loading integer number 3
        push:      v0		;; Push parameter onto stack
        v1 = call A_
        pop				;; Pop parameter from stack
        pop				;; Pop parameter from stack
        move:      v0 <- v1
        store:	y_ <- v0
        load:	v0 <- c_			;; Loading variable c_ into register
        iLoad:	t1 <- 1			;; Loading integer number 1
        add:	t0 <- v0 , t1
        store:	x_ <- t0
        goto:		Label2
    
Label3:
        iLoad:	v0 <- 1			;; Loading integer number 1
        load:	a0 <- b_			;; Moving the value to be printed into register a0
        write				;; This is where syscall will be made
        load:	v0 <- c_			;; Loading variable c_ into register
        load:	t1 <- b_			;; Loading variable b_ into register
        add:	t0 <- v0 , t1
        store:	a_ <- t0
epilogue_p_:
    add $sp, $sp, 12  # Increment stack pointer for local variables
    lw $fp, -4($sp)   # Set $fp to $sp-4
    lw $ra, 0($sp)    # Save ra
    jr $ra            # Jump back to the called procedure
# Epilogue Ends

.text          # The .text assembler directive indicates
    .globl main      # The following is the code (as opposed to data)
main:                # .globl makes main know to the outside of the program.
# Prologue begins
    sw $ra, 0($sp)    # Save the return address
    sw $fp, -4($sp)   # Save the frame pointer
    sub $fp, $sp, 4   # Update the frame pointer
    sub $sp, $sp, 12  # Make space for the locals
# Prologue ends

        load:	v0 <- b_			;; Loading variable b_ into register
        load:	t1 <- c_			;; Loading variable c_ into register
        mul:	t0 <- v0 , t1
        store:	a_ <- t0
        call p_
        load:	v0 <- a_			;; Loading variable a_ into register
        load:	t1 <- c_			;; Loading variable c_ into register
        add:	t0 <- v0 , t1
        store:	b_ <- t0
        iLoad:	v0 <- 1			;; Loading integer number 1
        load:	a0 <- a_			;; Moving the value to be printed into register a0
        write				;; This is where syscall will be made
epilogue_main:
    add $sp, $sp, 12  # Increment stack pointer for local variables
    lw $fp, -4($sp)   # Set $fp to $sp-4
    lw $ra, 0($sp)    # Save ra
    jr $ra            # Jump back to the called procedure
# Epilogue Ends

