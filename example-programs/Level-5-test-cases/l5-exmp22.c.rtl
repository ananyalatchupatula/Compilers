**PROCEDURE: main
**BEGIN: RTL Statements
    load:	v0 <- b_			;; Loading variable b_ into register
    load:	t1 <- c_			;; Loading variable c_ into register
    mul:	t0 <- v0 , t1
    store:	a_ <- t0
    iLoad:	v0 <- 2			;; Loading integer number 2
    push:      v0		;; Push parameter onto stack
    v1 = call p_
    pop				;; Pop parameter from stack
    move:      v0 <- v1
    store:	b_ <- v0
    load:	v0 <- a_			;; Loading variable a_ into register
    load:	t0 <- c_			;; Loading variable c_ into register
    add:	v0 <- v0 , t0
    store:	b_ <- v0
    iLoad:	v0 <- 1			;; Loading integer number 1
    load:	a0 <- a_			;; Moving the value to be printed into register a0
    write				;; This is where syscall will be made
**END: RTL Statements


**PROCEDURE: p_
**BEGIN: RTL Statements
    load:	v0 <- e_			;; Loading variable e_ into register
    iLoad:	t1 <- 0			;; Loading integer number 0
    sle:	t0 <- v0 , t1
    not:	v0 <- t0
    bgtz:	v0 , Label3
    iLoad:	v0 <- 1			;; Loading integer number 1
    store:	stemp0 <- v0
    goto:		Label1
    goto:		Label3

Label3:
    load:	v0 <- x_			;; Loading variable x_ into register
    iLoad:	t1 <- 0			;; Loading integer number 0
    sgt:	t0 <- v0 , t1
    not:	v0 <- t0
    bgtz:	v0 , Label5
    load:	v0 <- e_			;; Loading variable e_ into register
    iLoad:	t1 <- 1			;; Loading integer number 1
    sub:	t0 <- v0 , t1
    push:      t0		;; Push parameter onto stack
    v1 = call q_
    pop				;; Pop parameter from stack
    move:      v0 <- v1
    store:	x_ <- v0
    goto:		Label4

Label5:

Label6:
    load:	v0 <- a_			;; Loading variable a_ into register
    load:	t1 <- b_			;; Loading variable b_ into register
    sgt:	v0 <- v0 , t1
    not:	t1 <- v0
    bgtz:	t1 , Label7
    load:	v0 <- e_			;; Loading variable e_ into register
    iLoad:	t2 <- 1			;; Loading integer number 1
    sub:	t1 <- v0 , t2
    push:      t1		;; Push parameter onto stack
    v1 = call p_
    pop				;; Pop parameter from stack
    move:      v0 <- v1
    store:	a_ <- v0
    load:	v0 <- c_			;; Loading variable c_ into register
    iLoad:	t2 <- 1			;; Loading integer number 1
    add:	v0 <- v0 , t2
    store:	x_ <- v0
    goto:		Label6

Label7:

Label4:
    iLoad:	v0 <- 1			;; Loading integer number 1
    load:	a0 <- b_			;; Moving the value to be printed into register a0
    write				;; This is where syscall will be made
    load:	v0 <- c_			;; Loading variable c_ into register
    load:	t3 <- b_			;; Loading variable b_ into register
    add:	t2 <- v0 , t3
    store:	a_ <- t2
    iLoad:	v0 <- 1			;; Loading integer number 1
    store:	stemp0 <- v0
    goto:		Label1

Label1:
    load:	v1 <- stemp0			;; Loading variable stemp0 into register
    return      v1
**END: RTL Statements


**PROCEDURE: q_
**BEGIN: RTL Statements
    load:	v0 <- d_			;; Loading variable d_ into register
    iLoad:	t1 <- 0			;; Loading integer number 0
    sle:	t0 <- v0 , t1
    not:	v0 <- t0
    bgtz:	v0 , Label2
    iLoad:	v0 <- 0			;; Loading integer number 0
    store:	stemp0 <- v0
    goto:		Label0
    goto:		Label2

Label2:
    load:	v0 <- d_			;; Loading variable d_ into register
    iLoad:	t1 <- 1			;; Loading integer number 1
    sub:	t0 <- v0 , t1
    push:      t0		;; Push parameter onto stack
    v1 = call q_
    pop				;; Pop parameter from stack
    move:      v0 <- v1
    store:	a_ <- v0
    load:	v0 <- a_			;; Loading variable a_ into register
    iLoad:	t1 <- 1			;; Loading integer number 1
    add:	v0 <- v0 , t1
    store:	a_ <- v0
    iLoad:	v0 <- 1			;; Loading integer number 1
    store:	stemp0 <- v0
    goto:		Label0

Label0:
    load:	v1 <- stemp0			;; Loading variable stemp0 into register
    return      v1
**END: RTL Statements


