**PROCEDURE: f
**BEGIN: RTL Statements
    iLoad.d:	f2 <- 3.50			;; Loading integer number 3.50
    store.d:	stemp0 <- f2
    goto:		Label0
Label0:
**END: RTL Statements
**PROCEDURE: main
**BEGIN: RTL Statements
    iLoad.d:	f2 <- 2.00			;; Loading integer number 2.00
    store.d:	r_ <- f2
    load.d:	f2 <- temp0			;; Loading variable temp0 into register
    store.d:	r_ <- f2
**END: RTL Statements
