**PROCEDURE: f
**BEGIN: RTL Statements
    load:	v0 <- n_			;; Loading variable n_ into register
    iLoad:	t1 <- 0			;; Loading integer number 0
    seq:	t0 <- v0 , t1
    not:	v0 <- t0
    bgtz:	v0 , Label1
    iLoad:	v0 <- 1			;; Loading integer number 1
    store:	ret_ <- v0
    load:	v0 <- ret_			;; Loading variable ret_ into register
    store:	stemp0 <- v0
    goto:		Label0
    goto:		Label1
Label1:
    load:	v0 <- n_			;; Loading variable n_ into register
    iLoad:	t1 <- 1			;; Loading integer number 1
    sub:	t0 <- v0 , t1
    store:	k_ <- t0
    load:	v0 <- temp3			;; Loading variable temp3 into register
    store:	ret_ <- v0
    load:	v0 <- n_			;; Loading variable n_ into register
    load:	t1 <- ret_			;; Loading variable ret_ into register
    mul:	t0 <- v0 , t1
    store:	ret_ <- t0
    load:	v0 <- ret_			;; Loading variable ret_ into register
    store:	stemp0 <- v0
    goto:		Label0
Label0:
**END: RTL Statements
**PROCEDURE: main
**BEGIN: RTL Statements
    iLoad:	v0 <- 5			;; Loading integer number 5
    store:	b_ <- v0
    load:	v0 <- temp0			;; Loading variable temp0 into register
    store:	a_ <- v0
    iLoad:	v0 <- 1			;; Loading integer number 1
    load:	a0 <- a_			;; Moving the value to be printed into register a0
    write				;; This is where syscall will be made
    iLoad:	v0 <- 2			;; Loading integer number 2
    store:	m_ <- v0
    iLoad:	v0 <- 1			;; Loading integer number 1
    load:	a0 <- m_			;; Moving the value to be printed into register a0
    write				;; This is where syscall will be made
**END: RTL Statements
