.text          # The .text assembler directive indicates
    .globl f_      # The following is the code (as opposed to data)
f_:                # .globl makes main know to the outside of the program.
# Prologue begins
    sw $ra, 0($sp)    # Save the return address
    sw $fp, -4($sp)   # Save the frame pointer
    sub $fp, $sp, 4   # Update the frame pointer
    sub $sp, $sp, 12  # Make space for the locals
# Prologue ends

        load:	v0 <- n_			;; Loading variable n_ into register
        iLoad:	t1 <- 0			;; Loading integer number 0
        seq:	t0 <- v0 , t1
        not:	v0 <- t0
        bgtz:	v0 , Label1
        iLoad:	v0 <- 1			;; Loading integer number 1
        store:	ret_ <- v0
        load:	v0 <- ret_			;; Loading variable ret_ into register
        store:	stemp0 <- v0
        goto:		Label0
        goto:		Label1
    
Label1:
        load:	v0 <- n_			;; Loading variable n_ into register
        iLoad:	t1 <- 1			;; Loading integer number 1
        sub:	t0 <- v0 , t1
        store:	k_ <- t0
        load:	v0 <- k_			;; Loading variable k_ into register
        push:      v0		;; Push parameter onto stack
        v1 = call f_
        pop				;; Pop parameter from stack
        move:      v0 <- v1
        store:	ret_ <- v0
        load:	v0 <- n_			;; Loading variable n_ into register
        load:	t1 <- ret_			;; Loading variable ret_ into register
        mul:	t0 <- v0 , t1
        store:	ret_ <- t0
        load:	v0 <- ret_			;; Loading variable ret_ into register
        store:	stemp0 <- v0
        goto:		Label0
    
Label0:
        load:	v1 <- stemp0			;; Loading variable stemp0 into register
        return      v1
epilogue_f_:
    add $sp, $sp, 12  # Increment stack pointer for local variables
    lw $fp, -4($sp)   # Set $fp to $sp-4
    lw $ra, 0($sp)    # Save ra
    jr $ra            # Jump back to the called procedure
# Epilogue Ends

.text          # The .text assembler directive indicates
    .globl main      # The following is the code (as opposed to data)
main:                # .globl makes main know to the outside of the program.
# Prologue begins
    sw $ra, 0($sp)    # Save the return address
    sw $fp, -4($sp)   # Save the frame pointer
    sub $fp, $sp, 4   # Update the frame pointer
    sub $sp, $sp, 12  # Make space for the locals
# Prologue ends

        iLoad:	v0 <- 5			;; Loading integer number 5
        store:	b_ <- v0
        load:	v0 <- b_			;; Loading variable b_ into register
        push:      v0		;; Push parameter onto stack
        v1 = call f_
        pop				;; Pop parameter from stack
        move:      v0 <- v1
        store:	a_ <- v0
        iLoad:	v0 <- 1			;; Loading integer number 1
        load:	a0 <- a_			;; Moving the value to be printed into register a0
        write				;; This is where syscall will be made
        iLoad:	v0 <- 2			;; Loading integer number 2
        store:	m_ <- v0
        iLoad:	v0 <- 1			;; Loading integer number 1
        load:	a0 <- m_			;; Moving the value to be printed into register a0
        write				;; This is where syscall will be made
epilogue_main:
    add $sp, $sp, 12  # Increment stack pointer for local variables
    lw $fp, -4($sp)   # Set $fp to $sp-4
    lw $ra, 0($sp)    # Save ra
    jr $ra            # Jump back to the called procedure
# Epilogue Ends

