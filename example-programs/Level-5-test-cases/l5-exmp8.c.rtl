**PROCEDURE: f1_
**BEGIN: RTL Statements
    load:	v0 <- s_			;; Loading variable s_ into register
    store:	stemp0 <- v0
    goto:		Label0

Label0:
    load:	v1 <- stemp0			;; Loading variable stemp0 into register
    return      v1
**END: RTL Statements


**PROCEDURE: main
**BEGIN: RTL Statements
    load_addr:	v0 <- _str_0
    store:	s1_ <- v0
    load:	v0 <- s1_			;; Loading variable s1_ into register
    push:      v0		;; Push parameter onto stack
    v1 = call f1_
    pop				;; Pop parameter from stack
    move:      v0 <- v1
    store:	s2_ <- v0
    iLoad:	v0 <- 4			;; Loading integer number 4
    load:	a0 <- s1_			;; Moving the value to be printed into register a0
    write				;; This is where syscall will be made
**END: RTL Statements


