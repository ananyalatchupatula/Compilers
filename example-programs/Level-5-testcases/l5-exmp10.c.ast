**END: Abstract Syntax Tree
**PROCEDURE: main
  Return Type: <void>
  Formal Parameters:
**BEGIN: Abstract Syntax Tree
  Asgn:
      LHS (Name : a_<int>)
      RHS (Num : 3<int>)
FN CALL: h_()
  Asgn:
      LHS (Name : a_<int>)
      RHS (
          FN CALL: f1_(
          Name : a_<int>
          Name : a_<int>))
  Asgn:
      LHS (Name : b_<int>)
      RHS (
          FN CALL: g_())
FN CALL: h_()
  Asgn:
      LHS (Name : a_<int>)
