**PROCEDURE: f1_
  Return Type: <int>
  Formal Parameters:
      b_  Type:<int>
      c_  Type:<int>
**BEGIN: Abstract Syntax Tree
  Asgn:
      LHS (Name : d_<int>)
      RHS (
          Arith: Plus<int>
       L_Opd (Name : b_<int>)
       R_Opd (Name : c_<int>))
FN CALL: h_()
Return: 
      Arith: Plus<int>
     L_Opd (Name : d_<int>)
     R_Opd (Num : 2<int>)
**END: Abstract Syntax Tree
**PROCEDURE: g_
  Return Type: <int>
  Formal Parameters:
**BEGIN: Abstract Syntax Tree
FN CALL: h_()
  Asgn:
      LHS (Name : b_<int>)
      RHS (Num : 1<int>)
  Asgn:
      LHS (Name : b_<int>)
      RHS (
          FN CALL: f1_(
