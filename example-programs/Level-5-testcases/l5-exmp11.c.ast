**PROCEDURE: convert_centigrade_to_fahrenheit_
  Return Type: <float>
  Formal Parameters:
      ct_  Type:<float>
**BEGIN: Abstract Syntax Tree
  Asgn:
      LHS (Name : ft_<float>)
      RHS (
          Condition: EQ<bool>
       L_Opd (Name : ct_<float>)
       R_Opd (Num : 0.00<float>)
       True_Part (Num : 0.00<float>)
       False_Part (
        Arith: Plus<float>
       L_Opd (
         Arith: Div<float>
         L_Opd (
           Arith: Mult<float>
           L_Opd (Name : ct_<float>)
           R_Opd (Num : 9.00<float>))
         R_Opd (Num : 5.00<float>))
       R_Opd (Num : 32.00<float>)))
Return: Name : ft_<float>
**END: Abstract Syntax Tree
**PROCEDURE: main
  Return Type: <void>
  Formal Parameters:
**BEGIN: Abstract Syntax Tree
Write: String : "Input temperature in centigrade"<string>
Read: Name : in_<float>
  Asgn:
      LHS (Name : out_<float>)
      RHS (
          FN CALL: convert_centigrade_to_fahrenheit_(
          Name : in_<float>))
Write: String : "Temperature in fahrenheit is "<string>
Write: Name : out_<float>
**END: Abstract Syntax Tree
