**PROCEDURE: A_
  Return Type: <int>
  Formal Parameters:
      i_  Type:<int>
      j_  Type:<int>
**BEGIN: Abstract Syntax Tree
  If:
    Condition (
      Condition: OR<bool>
       L_Opd (
         Condition: LE<bool>
         L_Opd (Name : i_<int>)
         R_Opd (Num : 0<int>))
       R_Opd (
         Condition: LE<bool>
         L_Opd (Name : j_<int>)
         R_Opd (Num : 0<int>)))
    Then (
      Return: Num : 1<int>)
  Asgn:
      LHS (Name : x_<int>)
      RHS (
          FN CALL: A_(
          Arith: Minus<int>
           L_Opd (Name : i_<int>)
           R_Opd (Num : 1<int>)
          Name : j_<int>))
Return: Name : x_<int>
**END: Abstract Syntax Tree
**PROCEDURE: main
  Return Type: <void>
  Formal Parameters:
**BEGIN: Abstract Syntax Tree
  Asgn:
      LHS (Name : a_<int>)
      RHS (
          Arith: Mult<int>
       L_Opd (Name : b_<int>)
       R_Opd (Name : c_<int>))
FN CALL: p_()
  Asgn:
      LHS (Name : b_<int>)
      RHS (
          Arith: Plus<int>
       L_Opd (Name : a_<int>)
       R_Opd (Name : c_<int>))
Write: Name : a_<int>
**END: Abstract Syntax Tree
**PROCEDURE: p_
  Return Type: <void>
  Formal Parameters:
**BEGIN: Abstract Syntax Tree
  While:
    Condition (
      Condition: GT<bool>
       L_Opd (Name : a_<int>)
       R_Opd (Name : b_<int>))
    Body (
            Asgn:
          LHS (Name : y_<int>)
          RHS (
              FN CALL: A_(
              Num : 3<int>
              Num : 3<int>))
      Asgn:
          LHS (Name : x_<int>)
          RHS (
              Arith: Plus<int>
           L_Opd (Name : c_<int>)
           R_Opd (Num : 1<int>)))
Write: Name : b_<int>
  Asgn:
      LHS (Name : a_<int>)
      RHS (
          Arith: Plus<int>
       L_Opd (Name : c_<int>)
       R_Opd (Name : b_<int>))
**END: Abstract Syntax Tree
