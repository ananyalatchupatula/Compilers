.data
a_: .word 0
b_: .word 0
c_: .word 0
d_: .word 0
e_: .word 0
    .text           # The .text assembler directive indicates
    .globl main     # The following is the code (as opposed to data)
main:               # .globl makes main know to the outside of the program.
# Prologue begins
    sw $ra, 0($sp)      # Save the return address
    sw $fp, -4($sp)     # Save the frame pointer
    sub $fp, $sp, 4     # Update the frame pointer
    sub $sp, $sp, 12    # Make space for the locals
# Prologue ends

    li $v0, 5           # Source:5
    sw $v0, a_          # Dest: $v0
    li $v0, 3           # Source:3
    sw $v0, b_          # Dest: $v0
    li $v0, 7           # Source:7
    sw $v0, c_          # Dest: $v0
    li $v0, 2           # Source:2
    sw $v0, d_          # Dest: $v0
    jal p_
    lw $v0, a_          # Source:a_
    li $t1, 2           # Source:2
    add $t0, $v0, $t1   # Result: $t0, Opd1: $v0, Opd2:$t1
    sw $t0, a_          # Dest: $t0
    lw $v0, c_          # Source:c_
    lw $t1, d_          # Source:d_
    add $t0, $v0, $t1   # Result: $t0, Opd1: $v0, Opd2:$t1
    sw $t0, e_          # Dest: $t0
    lw $v0, a_          # Source:a_
    lw $t1, b_          # Source:b_
    mul $t0, $v0, $t1   # Result: $t0, Opd1: $v0, Opd2:$t1
    sw $t0, d_          # Dest: $t0
    lw $v0, a_          # Source:a_
    lw $t1, c_          # Source:c_
    add $t0, $v0, $t1   # Result: $t0, Opd1: $v0, Opd2:$t1
    lw $t1, e_          # Source:e_
    add $v0, $t0, $t1   # Result: $v0, Opd1: $t0, Opd2:$t1
    sw $v0, -4($fp)     # Dest: $v0
epilogue_main:
    add $sp, $sp, 12    # Increment stack pointer for local variables
    lw $fp, -4($sp)     # Set $fp to $sp-4
    lw $ra, 0($sp)      # Save ra
    jr $ra              # Jump back to the called procedure
# Epilogue Ends

    .text           # The .text assembler directive indicates
    .globl p_       # The following is the code (as opposed to data)
p_:                 # .globl makes main know to the outside of the program.
# Prologue begins
    sw $ra, 0($sp)      # Save the return address
    sw $fp, -4($sp)     # Save the frame pointer
    sub $fp, $sp, 4     # Update the frame pointer
    sub $sp, $sp, 12    # Make space for the locals
# Prologue ends

    li $v0, 2           # Source:2
    sw $v0, b_          # Dest: $v0
    lw $v0, b_          # Source:b_
    lw $t1, d_          # Source:d_
    slt $t0, $v0, $t1   # Comparing $v0 and $t1, Result in $t0
    xori $v0, $t0, 1    # Result: $v0, Opd1: $t0
    bgtz $v0, Label1
    lw $v0, a_          # Source:a_
    lw $t1, b_          # Source:b_
    add $t0, $v0, $t1   # Result: $t0, Opd1: $v0, Opd2:$t1
    sw $t0, c_          # Dest: $t0
    j Label0
Label1:
    jal q_
Label0:
    lw $v0, c_          # Source:c_
    lw $t1, d_          # Source:d_
    add $t0, $v0, $t1   # Result: $t0, Opd1: $v0, Opd2:$t1
    sw $t0, -4($fp)     # Dest: $t0
epilogue_p_:
    add $sp, $sp, 12    # Increment stack pointer for local variables
    lw $fp, -4($sp)     # Set $fp to $sp-4
    lw $ra, 0($sp)      # Save ra
    jr $ra              # Jump back to the called procedure
# Epilogue Ends

    .text           # The .text assembler directive indicates
    .globl q_       # The following is the code (as opposed to data)
q_:                 # .globl makes main know to the outside of the program.
# Prologue begins
    sw $ra, 0($sp)      # Save the return address
    sw $fp, -4($sp)     # Save the frame pointer
    sub $fp, $sp, 4     # Update the frame pointer
    sub $sp, $sp, 8     # Make space for the locals
# Prologue ends

    li $v0, 1           # Source:1
    sw $v0, a_          # Dest: $v0
    lw $v0, a_          # Source:a_
    lw $t1, b_          # Source:b_
    mul $t0, $v0, $t1   # Result: $t0, Opd1: $v0, Opd2:$t1
    sw $t0, a_          # Dest: $t0
epilogue_q_:
    add $sp, $sp, 8     # Increment stack pointer for local variables
    lw $fp, -4($sp)     # Set $fp to $sp-4
    lw $ra, 0($sp)      # Save ra
    jr $ra              # Jump back to the called procedure
# Epilogue Ends