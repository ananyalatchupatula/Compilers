.data
a_: .word 0
b_: .word 0
c_: .word 0

    .text               # The .text assembler directive indicates
    .globl A_           # The following is the code (as opposed to data)
A_:                     # .globl makes main know to the outside of the program.
# Prologue begins
    sw $ra, 0($sp)      # Save the return address
    sw $fp, -4($sp)     # Save the frame pointer
    sub $fp, $sp, 4     # Update the frame pointer
    sub $sp, $sp, 16    # Make space for the locals
# Prologue ends

    lw $v0, 8($fp)      # Source:i_
    li $t1, 0           # Source:0
    sle $t0, $v0, $t1   # Comparing $v0 and $t1, Result in $t0
    lw $v0, 12($fp)     # Source:j_
    li $t2, 0           # Source:0
    sle $t1, $v0, $t2   # Comparing $v0 and $t2, Result in $t1
    or $v0, $t0, $t1    # Result: $v0, Opd1: $t0, Opd2:$t1
    xori $t0, $v0, 1    # Result: $t0, Opd1: $v0
    bgtz $t0, Label1
    li $v0, 1           # Source:1
    sw $v0, -4($fp)     # Dest: $v0
    j Label0
    j Label1
Label1:
    lw $v0, 8($fp)      # Source:i_
    li $t1, 1           # Source:1
    sub $t0, $v0, $t1   # Result: $t0, Opd1: $v0, Opd2:$t1
    lw $v0, 12($fp)     # Source:j_
    sw $v0, 0($sp)      # store formal parameter at sp
    sub $sp, $sp, 4     # decrement the stack pointer by 4
    sw $t0, 0($sp)      # store formal parameter at sp
    sub $sp, $sp, 4     # decrement the stack pointer by 4
    jal A_
    add $sp, $sp, 4     # add the stack pointer by 4
    add $sp, $sp, 4     # add the stack pointer by 4
    move $v0, $v1       # store function call return in $v1 so that another function call can be made
    sw $v0, -8($fp)     # Dest: $v0
    lw $v0, -8($fp)     # Source:x_
    sw $v0, -4($fp)     # Dest: $v0
    j Label0
Label0:
    lw $v1, -4($fp)     # Moving the value to be returned into register v1
    j epilogue_A_

epilogue_A_:
    add $sp, $sp, 16    # Increment stack pointer for local variables
    lw $fp, -4($sp)     # Set $fp to $sp-4
    lw $ra, 0($sp)      # Save ra
    jr $ra              # Jump back to the called procedure
# Epilogue Ends

    .text               # The .text assembler directive indicates
    .globl main         # The following is the code (as opposed to data)
main:                   # .globl makes main know to the outside of the program.
# Prologue begins
    sw $ra, 0($sp)      # Save the return address
    sw $fp, -4($sp)     # Save the frame pointer
    sub $fp, $sp, 4     # Update the frame pointer
    sub $sp, $sp, 8     # Make space for the locals
# Prologue ends

    lw $v0, b_          # Source:b_
    lw $t1, c_          # Source:c_
    mul $t0, $v0, $t1   # Result: $t0, Opd1: $v0, Opd2:$t1
    sw $t0, a_          # Dest: $t0
    jal p_
    lw $v0, a_          # Source:a_
    lw $t1, c_          # Source:c_
    add $t0, $v0, $t1   # Result: $t0, Opd1: $v0, Opd2:$t1
    sw $t0, b_          # Dest: $t0
    li $v0, 1           # Loading 1 in v0 to indicate syscall to print integer value
    lw $a0, a_          # Moving the value to be printed into register a0
    syscall

epilogue_main:
    add $sp, $sp, 8     # Increment stack pointer for local variables
    lw $fp, -4($sp)     # Set $fp to $sp-4
    lw $ra, 0($sp)      # Save ra
    jr $ra              # Jump back to the called procedure
# Epilogue Ends

    .text               # The .text assembler directive indicates
    .globl p_           # The following is the code (as opposed to data)
p_:                     # .globl makes main know to the outside of the program.
# Prologue begins
    sw $ra, 0($sp)      # Save the return address
    sw $fp, -4($sp)     # Save the frame pointer
    sub $fp, $sp, 4     # Update the frame pointer
    sub $sp, $sp, 16    # Make space for the locals
# Prologue ends

Label2:
    lw $v0, a_          # Source:a_
    lw $t1, b_          # Source:b_
    sgt $t0, $v0, $t1   # Comparing $v0 and $t1, Result in $t0
    xori $v0, $t0, 1    # Result: $v0, Opd1: $t0
    bgtz $v0, Label3
    li $v0, 3           # Source:3
    sw $v0, 0($sp)      # store formal parameter at sp
    sub $sp, $sp, 4     # decrement the stack pointer by 4
    li $v0, 3           # Source:3
    sw $v0, 0($sp)      # store formal parameter at sp
    sub $sp, $sp, 4     # decrement the stack pointer by 4
    jal A_
    add $sp, $sp, 4     # add the stack pointer by 4
    add $sp, $sp, 4     # add the stack pointer by 4
    move $v0, $v1       # store function call return in $v1 so that another function call can be made
    sw $v0, -8($fp)     # Dest: $v0
    lw $v0, c_          # Source:c_
    li $t1, 1           # Source:1
    add $t0, $v0, $t1   # Result: $t0, Opd1: $v0, Opd2:$t1
    sw $t0, -4($fp)     # Dest: $t0
    j Labell2
Label3:
    li $v0, 1           # Loading 1 in v0 to indicate syscall to print integer value
    lw $a0, b_          # Moving the value to be printed into register a0
    syscall
    lw $v0, c_          # Source:c_
    lw $t1, b_          # Source:b_
    add $t0, $v0, $t1   # Result: $t0, Opd1: $v0, Opd2:$t1
    sw $t0, a_          # Dest: $t0

epilogue_p_:
    add $sp, $sp, 16    # Increment stack pointer for local variables
    lw $fp, -4($sp)     # Set $fp to $sp-4
    lw $ra, 0($sp)      # Save ra
    jr $ra              # Jump back to the called procedure
# Epilogue Ends