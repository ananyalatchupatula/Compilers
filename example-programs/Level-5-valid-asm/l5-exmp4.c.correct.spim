.data
m_: .word 0
    .text          # The .text assembler directive indicates
    .globl f_      # The following is the code (as opposed to data)
f_:                # .globl makes main know to the outside of the program.
# Prologue begins
    sw $ra, 0($sp)    # Save the return address
    sw $fp, -4($sp)   # Save the frame pointer
    sub $fp, $sp, 4   # Update the frame pointer
    sub $sp, $sp, 20  # Make space for the locals
# Prologue ends

    lw $v0, 8($fp)    # Source:n_
    li $t1, 0         # Source:0
    seq $t0, $v0, $t1 # Comparing $v0 and $t1, Result in $t0
    xori $v0, $t0, 1  # Result: $v0, Opd1: $t0
    bgtz $v0, Label1
    li $v0, 1         # Source:1
    sw $v0, -8($fp)   # Dest: $v0
    lw $v0, -8($fp)   # Source:ret_
    sw $v0, -4($fp)   # Dest: $v0
    j Label0
    j Label1
Label1:
    lw $v0, 8($fp)    # Source:n_
    li $t1, 1         # Source:1
    sub $t0, $v0, $t1 # Result: $t0, Opd1: $v0, Opd2:$t1
    sw $t0, -12($fp)  # Dest: $t0
    lw $v0, -12($fp)  # Source:k_
    sw $v0, 0($sp)    # store formal parameter at sp
    sub $sp, $sp, 4   # decrement the stack pointer by 4
    jal f_
    add $sp, $sp, 4   # add the stack pointer by 4
    move $v0, $v1     # store function call return in $v1 so that another function call can be made
    sw $v0, -8($fp)   # Dest: $v0
    lw $v0, 8($fp)    # Source:n_
    lw $t1, -8($fp)   # Source:ret_
    mul $t0, $v0, $t1 # Result: $t0, Opd1: $v0, Opd2:$t1
    sw $t0, -8($fp)   # Dest: $t0
    lw $v0, -8($fp)   # Source:ret_
    sw $v0, -4($fp)   # Dest: $v0
    j Label0
Label0:
    lw $v1, -4($fp)   # Moving the value to be printed into register a0
    j epilogue_f_
epilogue_f_:
    add $sp, $sp, 20  # Increment stack pointer for local variables
    lw $fp, -4($sp)   # Set $fp to $sp-4
    lw $ra, 0($sp)    # Save ra
    jr $ra            # Jump back to the called procedure
# Epilogue Ends

    .text          # The .text assembler directive indicates
    .globl main    # The following is the code (as opposed to data)
main:              # .globl makes main know to the outside of the program.
# Prologue begins
    sw $ra, 0($sp)    # Save the return address
    sw $fp, -4($sp)   # Save the frame pointer
    sub $fp, $sp, 4   # Update the frame pointer
    sub $sp, $sp, 16  # Make space for the locals
# Prologue ends

    li $v0, 5         # Source:5
    sw $v0, -8($fp)   # Dest: $v0
    lw $v0, -8($fp)   # Source:b_
    sw $v0, 0($sp)    # store formal parameter at sp
    sub $sp, $sp, 4   # decrement the stack pointer by 4
    jal f_
    add $sp, $sp, 4   # add the stack pointer by 4
    move $v0, $v1     # store function call return in $v1 so that another function call can be made
    sw $v0, -4($fp)   # Dest: $v0
    li $v0, 1         # Loading 1 in v0 to indicate syscall to print integer value
    lw $a0, -4($fp)   # Moving the value to be printed into register a0
    syscall
    li $v0, 2         # Source:2
    sw $v0, m_        # Dest: $v0
    li $v0, 1         # Loading 1 in v0 to indicate syscall to print integer value
    lw $a0, m_        # Moving the value to be printed into register a0
    syscall
epilogue_main:
    add $sp, $sp, 16  # Increment stack pointer for local variables
    lw $fp, -4($sp)   # Set $fp to $sp-4
    lw $ra, 0($sp)    # Save ra
    jr $ra            # Jump back to the called procedure
# Epilogue Ends