.data
x_: .word 0
y_: .word 0
z_: .word 0
    .text          # The .text assembler directive indicates
    .globl f2_     # The following is the code (as opposed to data)
f2_:               # .globl makes main know to the outside of the program.
# Prologue begins
    sw $ra, 0($sp)    # Save the return address
    sw $fp, -4($sp)   # Save the frame pointer
    sub $fp, $sp, 4   # Update the frame pointer
    sub $sp, $sp, 16  # Make space for the locals
# Prologue ends

    l.d $f2, 8($fp)   # Source:p_
    s.d $f2, -8($fp)  # Dest: $f2
    j Label1
Label1:
    l.d $f0, -8($fp)  # Moving the value to be printed into register a0
    j epilogue_f2_
epilogue_f2_:
    add $sp, $sp, 16  # Increment stack pointer for local variables
    lw $fp, -4($sp)   # Set $fp to $sp-4
    lw $ra, 0($sp)    # Save ra
    jr $ra            # Jump back to the called procedure
# Epilogue Ends

    .text          # The .text assembler directive indicates
    .globl f_      # The following is the code (as opposed to data)
f_:                # .globl makes main know to the outside of the program.
# Prologue begins
    sw $ra, 0($sp)    # Save the return address
    sw $fp, -4($sp)   # Save the frame pointer
    sub $fp, $sp, 4   # Update the frame pointer
    sub $sp, $sp, 16  # Make space for the locals
# Prologue ends

    l.d $f2, 8($fp)   # Source:p_
    s.d $f2, -8($fp)  # Dest: $f2
    j Label0
Label0:
    l.d $f0, -8($fp)  # Moving the value to be printed into register a0
    j epilogue_f_
epilogue_f_:
    add $sp, $sp, 16  # Increment stack pointer for local variables
    lw $fp, -4($sp)   # Set $fp to $sp-4
    lw $ra, 0($sp)    # Save ra
    jr $ra            # Jump back to the called procedure
# Epilogue Ends

    .text          # The .text assembler directive indicates
    .globl main    # The following is the code (as opposed to data)
main:              # .globl makes main know to the outside of the program.
# Prologue begins
    sw $ra, 0($sp)    # Save the return address
    sw $fp, -4($sp)   # Save the frame pointer
    sub $fp, $sp, 4   # Update the frame pointer
    sub $sp, $sp, 16  # Make space for the locals
# Prologue ends

    li.d $f2, 2.00    # Source:2.000000
    s.d $f2, -8($fp)  # Dest: $f2
    li.d $f2, 2.00    # Source:2.000000
    li.d $f6, 3.00    # Source:3.000000
    add.d $f4, $f2, $f6 # Result: $f4, Opd1: $f2, Opd2:$f6
    l.d $f2, -8($fp)  # Source:r_
    mul.d $f6, $f2, $f4 # Result: $f6, Opd1: $f2, Opd2:$f4
    s.d $f6, -8($fp)  # Dest: $f6
    l.d $f2, -8($fp)  # Source:r_
    li.d $f6, 2.00    # Source:2.000000
    mul.d $f4, $f2, $f6 # Result: $f4, Opd1: $f2, Opd2:$f6
    li $v0, 3         # Source:3
    sw $v0, 0($sp)    # store formal parameter at sp
    sub $sp, $sp, 4   # decrement the stack pointer by 4
    s.d $f4, -4($sp)  # store formal parameter at sp
    sub $sp, $sp, 8   # decrement the stack pointer by 8
    jal f_
    add $sp, $sp, 8   # increment the stack pointer by 8
    add $sp, $sp, 4   # add the stack pointer by 4
    mov.d $f2, $f0    # store function call return in $f0 so that another function call can be made
    s.d $f2, -8($fp)  # Dest: $f2
epilogue_main:
    add $sp, $sp, 16  # Increment stack pointer for local variables
    lw $fp, -4($sp)   # Set $fp to $sp-4
    lw $ra, 0($sp)    # Save ra
    jr $ra            # Jump back to the called procedure
# Epilogue Ends