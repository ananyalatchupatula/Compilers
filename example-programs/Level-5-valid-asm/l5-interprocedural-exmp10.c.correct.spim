        .data
a_:     .word 0
b_:     .word 0

        .text           # The .text assembler directive indicates
        .globl main     # The following is the code (as opposed to data)
main:                   # .globl makes main know to the outside of the program.
# Prologue begins
        sw $ra, 0($sp)          # Save the return address
        sw $fp, -4($sp)         # Save the frame pointer
        sub $fp, $sp, 4         # Update the frame pointer
        sub $sp, $sp, 12        # Make space for the locals
# Prologue ends

        jal r_
        li $v0, 1               # Source:1
        sw $v0, a_              # Dest: $v0
        li $v0, 2               # Source:2
        sw $v0, -4($fp)         # Dest: $v0
        jal p_
        li $v0, 1               # Loading 1 in v0 to indicate syscall to print integer value
        lw $a0, a_              # Moving the value to be printed into register a0
        syscall

        li $v0, 1               # Loading 1 in v0 to indicate syscall to print integer value
        lw $a0, -4($fp)         # Moving the value to be printed into register a0
        syscall
        jal q_

epilogue_main:
        add $sp, $sp, 12        # Increment stack pointer for local variables
        lw $fp, -4($sp)         # Set $fp to $sp-4
        lw $ra, 0($sp)          # Save ra
        jr $ra                  # Jump back to the called procedure
# Epilogue Ends


        .text           # The .text assembler directive indicates
        .globl p_       # The following is the code (as opposed to data)
p_:                     # .globl makes main know to the outside of the program.
# Prologue begins
        sw $ra, 0($sp)          # Save the return address
        sw $fp, -4($sp)         # Save the frame pointer
        sub $fp, $sp, 4         # Update the frame pointer
        sub $sp, $sp, 8         # Make space for the locals
# Prologue ends

        li $v0, 1               # Source:1
        sw $v0, a_              # Dest: $v0

epilogue_p_:
        add $sp, $sp, 8         # Increment stack pointer for local variables
        lw $fp, -4($sp)         # Set $fp to $sp-4
        lw $ra, 0($sp)          # Save ra
        jr $ra                  # Jump back to the called procedure
# Epilogue Ends


        .text           # The .text assembler directive indicates
        .globl q_       # The following is the code (as opposed to data)
q_:                     # .globl makes main know to the outside of the program.
# Prologue begins
        sw $ra, 0($sp)          # Save the return address
        sw $fp, -4($sp)         # Save the frame pointer
        sub $fp, $sp, 4         # Update the frame pointer
        sub $sp, $sp, 8         # Make space for the locals
# Prologue ends

        jal p_
        li $v0, 1               # Loading 1 in v0 to indicate syscall to print integer value
        lw $a0, a_              # Moving the value to be printed into register a0
        syscall

epilogue_q_:
        add $sp, $sp, 8         # Increment stack pointer for local variables
        lw $fp, -4($sp)         # Set $fp to $sp-4
        lw $ra, 0($sp)          # Save ra
        jr $ra                  # Jump back to the called procedure
# Epilogue Ends


        .text           # The .text assembler directive indicates
        .globl r_       # The following is the code (as opposed to data)
r_:                     # .globl makes main know to the outside of the program.
# Prologue begins
        sw $ra, 0($sp)          # Save the return address
        sw $fp, -4($sp)         # Save the frame pointer
        sub $fp, $sp, 4         # Update the frame pointer
        sub $sp, $sp, 8         # Make space for the locals
# Prologue ends

        jal p_
        li $v0, 1               # Loading 1 in v0 to indicate syscall to print integer value
        lw $a0, b_              # Moving the value to be printed into register a0
        syscall

epilogue_r_:
        add $sp, $sp, 8         # Increment stack pointer for local variables
        lw $fp, -4($sp)         # Set $fp to $sp-4
        lw $ra, 0($sp)          # Save ra
        jr $ra                  # Jump back to the called procedure
# Epilogue Ends