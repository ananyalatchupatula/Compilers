**PROCEDURE: main
  Return Type: <void>
  Formal Parameters:
**BEGIN: Abstract Syntax Tree
    Asgn:
      LHS (Name : a_<int>)
      RHS (Num : 1<int>)
    Asgn:
      LHS (Name : b_<int>)
      RHS (Num : 2<int>)
    Asgn:
      LHS (Name : c_<int>)
      RHS (Num : 3<int>)
    Asgn:
      LHS (Name : a_<int>)
      RHS (
        Arith: Mult<int>
          L_Opd (Name : b_<int>)
          R_Opd (Name : c_<int>))
    FN CALL: p_()
    Asgn:
      LHS (Name : b_<int>)
      RHS (
        Arith: Plus<int>
          L_Opd (Name : a_<int>)
          R_Opd (Name : c_<int>))
    Write: Name : a_<int>
**END: Abstract Syntax Tree

**PROCEDURE: p_
  Return Type: <void>
  Formal Parameters:
**BEGIN: Abstract Syntax Tree
    Write: Name : a_<int>
    Write: Name : b_<int>
    Asgn:
      LHS (Name : b_<int>)
      RHS (
        Arith: Plus<int>
          L_Opd (Name : c_<int>)
          R_Opd (Num : 1<int>))
    Write: Name : b_<int>
    Asgn:
      LHS (Name : a_<int>)
      RHS (
        Arith: Plus<int>
          L_Opd (Name : c_<int>)
          R_Opd (Name : b_<int>))
**END: Abstract Syntax Tree