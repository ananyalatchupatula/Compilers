**PROCEDURE: main
  Return Type: <void>
  Formal Parameters:
**BEGIN: Abstract Syntax Tree
    Asgn:
      LHS (Name : a_<int>)
      RHS (
        Arith: Plus<int>
          L_Opd (Name : b_<int>)
          R_Opd (Name : c_<int>))
    While:
      Condition (
        Condition: GT<bool>
          L_Opd (Name : a_<int>)
          R_Opd (Name : d_<int>))
      Body (
        Asgn:
          LHS (Name : a_<int>)
          RHS (
            Arith: Plus<int>
              L_Opd (Name : a_<int>)
              R_Opd (Num : 2<int>)))
    Asgn:
      LHS (Name : x_<string>)
      RHS (String : "hello"<string>)
    Asgn:
      LHS (Name : z_<string>)
      RHS (
        FN CALL: p_(
          Name : x_<string>))
**END: Abstract Syntax Tree

**PROCEDURE: p_
  Return Type: <string>
  Formal Parameters:
    y_  Type:<string>
**BEGIN: Abstract Syntax Tree
    Asgn:
      LHS (Name : a_<int>)
      RHS (Num : 2<int>)
    Asgn:
      LHS (Name : y_<string>)
      RHS (String : "Hello"<string>)
    Write: Name : b_<int>
    If:
      Condition (
        Condition: GT<bool>
          L_Opd (Name : a_<int>)
          R_Opd (Name : c_<int>))
      Then (
        Write: Name : b_<int>)
      Else (
        Write: Name : a_<int>)
    Asgn:
      LHS (Name : x_<string>)
      RHS (Name : y_<string>)
    Return: Name : x_<string>
**END: Abstract Syntax Tree