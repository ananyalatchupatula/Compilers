**PROCEDURE: convert_centigrade_to_fahrenheit_
**BEGIN: RTL Statements
    load.d:     f2 <- ct_              ;; Loading variable ct_ into register
    iLoad.d:    f4 <- 0.00             ;; Loading float number 0.000000
    seq.d:      f7 , f2 , f4
    iLoad:      v0 <- 1
    move:       t0 <- zero
    movt:       t0 <- v0 , 0
    not:        v0 <- t0
    bgtz:       v0 , Label1

    iLoad.d:    f2 <- 0.00             ;; Loading float number 0.000000
    store.d:    stemp1 <- f2
    goto:       Label2

Label1:
    load.d:     f2 <- ct_              ;; Loading variable ct_ into register
    iLoad.d:    f6 <- 9.00             ;; Loading float number 9.000000
    mul.d:      f4 <- f2 , f6
    iLoad.d:    f6 <- 5.00             ;; Loading float number 5.000000
    div.d:      f2 <- f4 , f6
    iLoad.d:    f6 <- 32.00            ;; Loading float number 32.000000
    add.d:      f4 <- f2 , f6
    store.d:    stemp1 <- f4

Label2:
    load.d:     f2 <- stemp1           ;; Loading variable stemp1 into register
    store.d:    ft_ <- f2
    load.d:     f2 <- ft_              ;; Loading variable ft_ into register
    store.d:    stemp0 <- f2
    goto:       Label0

Label0:
    load.d:     f0 <- stemp0           ;; Moving the value to be returned into register f0
    return      f0
**END: RTL Statements

**PROCEDURE: main
**BEGIN: RTL Statements
    iLoad:      v0 <- 4                ;; Loading 4 in v0 to indicate syscall to print string value
    load_addr:  a0 <- _str_0           ;; String = "Input temperature in centigrade"
    write                                ;; This is where syscall will be made

    iLoad:      v0 <- 7                ;; Loading 7 in v0 to indicate syscall to read double value
    read                                 ;; This is where syscall will be made
    store.d:    in_ <- f0              ;; Moving the read value from register f0

    load.d:     f2 <- in_              ;; Loading variable in_ into register
    push:       f2                     ;; Push parameter onto stack
    f0 = call convert_centigrade_to_fahrenheit_
    pop                                  ;; Pop parameter in_ from stack
    move.d:     f2 <- f0
    store.d:    out_ <- f2

    iLoad:      v0 <- 4                ;; Loading 4 in v0 to indicate syscall to print string value
    load_addr:  a0 <- _str_1           ;; String = "Temperature in fahrenheit is "
    write                                ;; This is where syscall will be made

    iLoad:      v0 <- 3                ;; Loading 3 in v0 to indicate syscall to print double value
    load.d:     f12 <- out_            ;; Moving the value to be printed into register f12
    write                                ;; This is where syscall will be made
**END: RTL Statements