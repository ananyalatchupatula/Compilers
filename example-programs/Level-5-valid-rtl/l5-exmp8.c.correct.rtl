**PROCEDURE: f1_
**BEGIN: RTL Statements
    load:      v0 <- s_          ;; Loading variable s_ into register
    store:     stemp0 <- v0
    goto:      Label0

Label0:
    load:      v1 <- stemp0      ;; Moving the value to be returned into register v1
    return      v1
**END: RTL Statements


**PROCEDURE: main
**BEGIN: RTL Statements
    load_addr: v0 <- _str_0      ;; String = "Hello"
    store:     s1_ <- v0

    load:      v0 <- s1_         ;; Loading variable s1_ into register
    push:      v0                ;; Push parameter onto stack
    v1 = call f1_
    pop                           ;; Pop parameter s1_ from stack

    move:      v0 <- v1
    store:     s2_ <- v0

    iLoad:     v0 <- 4           ;; Print string syscall
    load:      a0 <- s1_
    write
**END: RTL Statements