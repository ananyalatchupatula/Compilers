**PROCEDURE: main
**BEGIN: RTL Statements
    store:	n_ <- 5
    store:	fact_ <- 1
    store:	c_ <- 1
Label0:
    add:	v0 <- c_ , n_
    not:	v1 <- v0
    bgtz:	v1 , Label1
    mul:	t0 <- fact_ , c_
    store:	fact_ <- t0
    add:	t1 <- c_ , 1
    store:	c_ <- t1
    goto:		Label0
Label1:
**END: RTL Statements
