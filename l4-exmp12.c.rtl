**PROCEDURE: main
**BEGIN: RTL Statements
    store:	b_ <- 2
    store:	c_ <- 8
    div:	v0 <- b_ , c_
    div:	v1 <- v0 , a_
    mul:	t0 <- v1 , b_
    add:	t1 <- a_ , t0
    sgt:	t2 <- t1 , 0
    not:	t3 <- t2
    bgtz:	t3 , Label0
    sub:	t4 <- a_ , 1
    store:	a_ <- t4
    goto:		Label0
Label0:
**END: RTL Statements
