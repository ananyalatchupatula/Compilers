**PROCEDURE: main
**BEGIN: RTL Statements
    store:	a_ <- 2
    store:	b_ <- 3
    store:	c_ <- 4
    store:	d_ <- 5
    store:	e_ <- 6
    add:	v0 <- b_ , c_
    add:	v1 <- a_ , v0
    mul:	t0 <- e_ , d_
    div:	t1 <- t0 , c_
    sgt:	t2 <- d_ , t1
    add:	t3 <- v1 , t2
    not:	t4 <- t3
    bgtz:	t4 , Label1
    mul:	t5 <- a_ , d_
    div:	t6 <- t5 , e_
    store:	a_ <- t6
    goto:		Label0
Label1:
    add:	t7 <- e_ , d_
    store:	e_ <- t7
Label0:
**END: RTL Statements
