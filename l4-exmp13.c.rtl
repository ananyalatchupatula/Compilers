**PROCEDURE: main
**BEGIN: RTL Statements
    fLoad:	v0 <- 2.30
    store:	a_ <- v0
    fLoad:	v0 <- 3.40
    store:	b_ <- v0
    fLoad:	v0 <- 4.50
    store:	c_ <- v0
    fLoad:	v0 <- 5.60
    store:	d_ <- v0
    fLoad:	v0 <- 6.70
    store:	e_ <- v0
    load:	v0 <- b_			;; Loading variable b_ into register
    load:	t1 <- c_			;; Loading variable c_ into register
    add:	t0 <- v0 , t1
    load:	v0 <- a_			;; Loading variable a_ into register
    load:	t1 <- temp0			;; Loading variable temp0 into register
    sge:	t0 <- v0 , t1
    load:	v0 <- e_			;; Loading variable e_ into register
    load:	t1 <- d_			;; Loading variable d_ into register
    mul:	t0 <- v0 , t1
    load:	t1 <- c_			;; Loading variable c_ into register
    div:	t1 <- t0 , t1
    load:	v0 <- d_			;; Loading variable d_ into register
    load:	t1 <- temp3			;; Loading variable temp3 into register
    sgt:	t0 <- v0 , t1
    load:	t1 <- temp4			;; Loading variable temp4 into register
    and:	t1 <- t0 , t1
    not:	v0 <- t1
    bgtz:	v0 , Label1
    load:	v0 <- a_			;; Loading variable a_ into register
    load:	t1 <- d_			;; Loading variable d_ into register
    mul:	t0 <- v0 , t1
    load:	t1 <- e_			;; Loading variable e_ into register
    div:	t1 <- t0 , t1
    store:	a_ <- t1
    goto:		Label0
Label1:
    load:	v0 <- e_			;; Loading variable e_ into register
    load:	t1 <- d_			;; Loading variable d_ into register
    add:	t0 <- v0 , t1
    store:	e_ <- t0
Label0:
**END: RTL Statements
