**PROCEDURE: main
**BEGIN: RTL Statements
    store:	year_ <- 1990
    div:	v0 <- year_ , 400
    mul:	v1 <- v0 , 400
    seq:	t0 <- v1 , year_
    not:	t1 <- t0
    bgtz:	t1 , Label1
    store:	cntr_ <- 1
    goto:		Label0
Label1:
    div:	t2 <- year_ , 100
    mul:	t3 <- t2 , 100
    seq:	t4 <- t3 , year_
    not:	t5 <- t4
    bgtz:	t5 , Label3
    store:	cntr_ <- 0
    goto:		Label2
Label3:
    div:	t6 <- year_ , 4
    mul:	t7 <- t6 , 4
    seq:	t8 <- t7 , year_
    not:	t9 <- t8
    bgtz:	t9 , Label5
    store:	cntr_ <- 1
    goto:		Label4
Label5:
    store:	cntr_ <- 0
Label4:
Label2:
Label0:
**END: RTL Statements
