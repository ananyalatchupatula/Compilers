**PROCEDURE: main
**BEGIN: RTL Statements
    iLoad:	v0 <- 1990			;; Loading integer number 1990
    store:	year_ <- v0
    load:	v0 <- year_			;; Loading variable year_ into register
    iLoad:	t1 <- 400			;; Loading integer number 400
    div:	t0 <- v0 , t1
    iLoad:	t1 <- 400			;; Loading integer number 400
    mul:	v0 <- t0 , t1
    load:	t1 <- year_			;; Loading variable year_ into register
    seq:	t0 <- v0 , t1
    not:	v0 <- t0
    bgtz:	v0 , Label1
    iLoad:	v0 <- 1			;; Loading integer number 1
    store:	cntr_ <- v0
    goto:		Label0
Label1:
    load:	v0 <- year_			;; Loading variable year_ into register
    iLoad:	t1 <- 100			;; Loading integer number 100
    div:	t0 <- v0 , t1
    iLoad:	t1 <- 100			;; Loading integer number 100
    mul:	v0 <- t0 , t1
    load:	t1 <- year_			;; Loading variable year_ into register
    seq:	t0 <- v0 , t1
    not:	v0 <- t0
    bgtz:	v0 , Label3
    iLoad:	v0 <- 0			;; Loading integer number 0
    store:	cntr_ <- v0
    goto:		Label2
Label3:
    load:	v0 <- year_			;; Loading variable year_ into register
    iLoad:	t1 <- 4			;; Loading integer number 4
    div:	t0 <- v0 , t1
    iLoad:	t1 <- 4			;; Loading integer number 4
    mul:	v0 <- t0 , t1
    load:	t1 <- year_			;; Loading variable year_ into register
    seq:	t0 <- v0 , t1
    not:	v0 <- t0
    bgtz:	v0 , Label5
    iLoad:	v0 <- 1			;; Loading integer number 1
    store:	cntr_ <- v0
    goto:		Label4
Label5:
    iLoad:	v0 <- 0			;; Loading integer number 0
    store:	cntr_ <- v0
Label4:
Label2:
Label0:
**END: RTL Statements
