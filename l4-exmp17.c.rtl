**PROCEDURE: main
**BEGIN: RTL Statements
    store:	a_ <- 5
    store:	b_ <- 1
Label2:
    add:	v0 <- a_ , 1
    store:	a_ <- v0
    add:	v1 <- b_ , 2
    not:	t0 <- v1
    bgtz:	t0 , Label1
    add:	t1 <- b_ , 1
    store:	b_ <- t1
    goto:		Label0
Label1:
    sub:	t2 <- b_ , 1
    store:	b_ <- t2
Label0:
    add:	t3 <- a_ , 10
    bgtz:	t3 , Label2
**END: RTL Statements
