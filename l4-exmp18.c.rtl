**PROCEDURE: main
**BEGIN: RTL Statements
    store:	max_ <- 0
    store:	a_ <- 5
    store:	b_ <- 1
    sgt:	v0 <- a_ , max_
    not:	v1 <- v0
    bgtz:	v1 , Label1
    store:	max_ <- a_
    goto:		Label0
Label1:
    sgt:	t0 <- b_ , max_
    not:	t1 <- t0
    bgtz:	t1 , Label3
    store:	max_ <- b_
    goto:		Label2
Label3:
    sgt:	t2 <- c_ , max_
    not:	t3 <- t2
    bgtz:	t3 , Label4
    store:	max_ <- c_
    goto:		Label4
Label4:
Label2:
Label0:
    store:	c_ <- 2
**END: RTL Statements
