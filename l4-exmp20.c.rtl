**PROCEDURE: main
**BEGIN: RTL Statements
    store:	a_ <- 5
    store:	b_ <- 1
Label2:
    add:	v0 <- a_ , 10
    not:	v1 <- v0
    bgtz:	v1 , Label3
    add:	t0 <- a_ , 1
    store:	a_ <- t0
Label0:
    add:	t1 <- b_ , 5
    not:	t2 <- t1
    bgtz:	t2 , Label1
    add:	t3 <- b_ , 1
    store:	b_ <- t3
    store:	a_ <- 2
    goto:		Label0
Label1:
    goto:		Label2
Label3:
**END: RTL Statements
