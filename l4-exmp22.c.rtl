**PROCEDURE: main
**BEGIN: RTL Statements
    store:	a_ <- 2
    store:	b_ <- 3
    add:	v0 <- a_ , b_
    sub:	v1 <- a_ , b_
    add:	t0 <- v0 , v1
    not:	t1 <- t0
    bgtz:	t1 , Label0
    mul:	t2 <- a_ , b_
    store:	t3 <- t2
    goto:		Label1
Label0:
    sub:	t4 <- a_ , b_
    store:	t3 <- t4
Label1:
    store:	d_ <- t3
**END: RTL Statements
