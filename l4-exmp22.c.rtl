**PROCEDURE: main
**BEGIN: RTL Statements
    iLoad.d:	f2 <- 2.30			;; Loading float number 2.30
    store.d:	a_ <- f2
    iLoad.d:	f2 <- 3.40			;; Loading float number 3.40
    store.d:	b_ <- f2
    load.d:	f2 <- a_			;; Loading variable a_ into register
    load.d:	f6 <- b_			;; Loading variable b_ into register
    add.d:	f4 <- f2 , f6
    load.d:	f2 <- a_			;; Loading variable a_ into register
    load.d:	f6 <- b_			;; Loading variable b_ into register
    sub.d:	f4 <- f2 , f6
    slt.d:	f2 <- f4 , f4
    not:	f4 <- f2
    bgtz:	f4 , Label0
    load.d:	f2 <- a_			;; Loading variable a_ into register
    load.d:	f6 <- b_			;; Loading variable b_ into register
    mul.d:	f4 <- f2 , f6
    store.d:	stemp0 <- f4
    goto:		Label1
Label0:
    load.d:	f2 <- a_			;; Loading variable a_ into register
    load.d:	f6 <- b_			;; Loading variable b_ into register
    sub.d:	f4 <- f2 , f6
    store.d:	stemp0 <- f4
Label1:
    load:	v0 <- stemp0			;; Loading variable stemp0 into register
    store:	d_ <- v0
**END: RTL Statements
