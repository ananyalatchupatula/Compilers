**PROCEDURE: main
**BEGIN: RTL Statements
    fLoad:	v0 <- 2.30
    store:	a_ <- v0
    fLoad:	v0 <- 3.40
    store:	b_ <- v0
    load:	v0 <- a_			;; Loading variable a_ into register
    load:	t1 <- b_			;; Loading variable b_ into register
    add:	t0 <- v0 , t1
    load:	v0 <- a_			;; Loading variable a_ into register
    load:	t1 <- b_			;; Loading variable b_ into register
    sub:	t0 <- v0 , t1
    slt:	v0 <- t0 , t0
    not:	t0 <- v0
    bgtz:	t0 , Label0
    load:	v0 <- a_			;; Loading variable a_ into register
    load:	t1 <- b_			;; Loading variable b_ into register
    mul:	t0 <- v0 , t1
    store:	stemp0 <- t0
    goto:		Label1
Label0:
    load:	v0 <- a_			;; Loading variable a_ into register
    load:	t1 <- b_			;; Loading variable b_ into register
    sub:	t0 <- v0 , t1
    store:	stemp0 <- t0
Label1:
    load:	v0 <- stemp0			;; Loading variable stemp0 into register
    store:	d_ <- v0
**END: RTL Statements
