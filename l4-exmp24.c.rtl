**PROCEDURE: main
**BEGIN: RTL Statements
    store:	a_ <- 2
    store:	b_ <- 3
    store:	c_ <- 4
    sgt:	v0 <- b_ , a_
    not:	v1 <- v0
    bgtz:	v1 , Label2
    sgt:	t0 <- b_ , c_
    not:	t1 <- t0
    bgtz:	t1 , Label0
    store:	t2 <- b_
    goto:		Label1
Label0:
    store:	t2 <- c_
Label1:
    store:	a_ <- t2
    goto:		Label2
Label2:
**END: RTL Statements
