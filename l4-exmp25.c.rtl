**PROCEDURE: main
**BEGIN: RTL Statements
    store:	maxInput_ <- 10
    store:	sum_ <- 0
    store:	i_ <- 2
    store:	number_ <- 2
Label0:
    add:	v0 <- i_ , maxInput_
    not:	v1 <- v0
    bgtz:	v1 , Label1
    add:	t0 <- i_ , 2
    store:	i_ <- t0
    goto:		Label0
Label1:
    add:	t1 <- number_ , 3
    not:	t2 <- t1
    bgtz:	t2 , Label2
    store:	number_ <- 5
    goto:		Label2
Label2:
    add:	t3 <- sum_ , number_
    store:	sum_ <- t3
**END: RTL Statements
