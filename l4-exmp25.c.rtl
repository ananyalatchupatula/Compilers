**PROCEDURE: main
**BEGIN: RTL Statements
    iLoad:	v0 <- 10			;; Loading integer number 10
    store:	maxInput_ <- v0
    iLoad:	v0 <- 0			;; Loading integer number 0
    store:	sum_ <- v0
    iLoad:	v0 <- 2			;; Loading integer number 2
    store:	i_ <- v0
    iLoad:	v0 <- 2			;; Loading integer number 2
    store:	number_ <- v0
Label0:
    load:	v0 <- i_			;; Loading variable i_ into register
    load:	t1 <- maxInput_			;; Loading variable maxInput_ into register
    slt:	t0 <- v0 , t1
    not:	v0 <- t0
    bgtz:	v0 , Label1
    iLoad:	v0 <- 1			;; Loading integer number 1
    load:	a0 <- i_			;; Loading variable i_ into register
    write				;; This is where syscall will be made
    load:	v0 <- i_			;; Loading variable i_ into register
    iLoad:	t1 <- 2			;; Loading integer number 2
    add:	t0 <- v0 , t1
    store:	i_ <- t0
    goto:		Label0
Label1:
    load:	v0 <- number_			;; Loading variable number_ into register
    iLoad:	t1 <- 3			;; Loading integer number 3
    slt:	t0 <- v0 , t1
    not:	v0 <- t0
    bgtz:	v0 , Label2
    iLoad:	v0 <- 5			;; Loading integer number 5
    store:	number_ <- v0
    goto:		Label2
Label2:
    load:	v0 <- sum_			;; Loading variable sum_ into register
    load:	t1 <- number_			;; Loading variable number_ into register
    add:	t0 <- v0 , t1
    store:	sum_ <- t0
    iLoad:	v0 <- 1			;; Loading integer number 1
    load:	a0 <- sum_			;; Loading variable sum_ into register
    write				;; This is where syscall will be made
**END: RTL Statements
