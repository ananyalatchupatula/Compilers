**PROCEDURE: main
**BEGIN: RTL Statements
    store:	global2_ <- local_
    store:	global1_ <- 5
    sgt:	v0 <- global2_ , global1_
    sub:	v1 <- local_ , 2
    add:	t0 <- v1 , 0
    add:	t1 <- v0 , t0
    not:	t2 <- t1
    bgtz:	t2 , Label0
    store:	t3 <- 1
    goto:		Label1
Label0:
    store:	t3 <- 0
Label1:
    store:	ans_ <- t3
    seq:	t4 <- ans_ , 1
    not:	t5 <- t4
    bgtz:	t5 , Label5
Label2:
    sgt:	t6 <- global2_ , 0
    not:	t7 <- t6
    bgtz:	t7 , Label3
    sub:	t8 <- global2_ , 1
    store:	global2_ <- t8
    goto:		Label2
Label3:
    goto:		Label4
Label5:
Label6:
    add:	t9 <- global2_ , 1
    store:	global2_ <- t9
    add:	s0 <- global2_ , 10
    bgtz:	s0 , Label6
Label4:
**END: RTL Statements
