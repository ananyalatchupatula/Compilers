**PROCEDURE: main
**BEGIN: RTL Statements
    store:	a_ <- 5
    store:	b_ <- 1
    sgt:	v0 <- 3 , 2
    not:	v1 <- v0
    bgtz:	v1 , Label0
    store:	t0 <- a_
    goto:		Label1
Label0:
    store:	t0 <- 4
Label1:
    sgt:	t1 <- t0 , 5
    not:	t2 <- t1
    bgtz:	t2 , Label3
    store:	c_ <- 10
    goto:		Label2
Label3:
    seq:	t3 <- a_ , 5
    not:	t4 <- t3
    bgtz:	t4 , Label4
    store:	c_ <- 2
    goto:		Label4
Label4:
Label2:
**END: RTL Statements
