**PROCEDURE: main
**BEGIN: RTL Statements
    sgt:	v0 <- a_ , 20
    not:	v1 <- v0
    not:	t0 <- v1
    bgtz:	t0 , Label1
    store:	a_ <- 30
    goto:		Label0
Label1:
    store:	a_ <- 40
Label0:
Label2:
    sgt:	t1 <- a_ , 30
    not:	t2 <- t1
    bgtz:	t2 , Label3
    store:	a_ <- 40
    goto:		Label2
Label3:
    add:	t3 <- 30
    store:	a_ <- t3
    add:	t4 <- a_
    sgt:	t5 <- t4 , 30
    not:	t6 <- t5
    bgtz:	t6 , Label4
    store:	a_ <- 50
    goto:		Label4
Label4:
**END: RTL Statements
