**PROCEDURE: main
**BEGIN: RTL Statements
    sgt:	v0 <- a_ , 20
    not:	v1 <- v0
    bgtz:	v1 , Label1
    store:	b_ <- 20
    goto:		Label0
Label1:
    store:	c_ <- 28
Label0:
Label2:
    sgt:	t0 <- b_ , 20
    add:	t1 <- c_ , 30
    add:	t2 <- t0 , t1
    not:	t3 <- t2
    bgtz:	t3 , Label3
    add:	t4 <- b_ , 1
    store:	b_ <- t4
    goto:		Label2
Label3:
Label4:
    add:	t5 <- c_ , 2
    store:	c_ <- t5
    sgt:	t6 <- c_ , 30
    bgtz:	t6 , Label4
**END: RTL Statements
