Grammar

    0 $accept: program $end

    1 program: globals_var_decls func_list

    2 func_list: func_list func_def_item
    3          | func_def_item

    4 func_def_item: func_def

    5 globals_var_decls: globals_var_decls var_decl
    6                  | ε

    7 var_decl: type id_list SEMICOLON

    8 type: INTEGER
    9     | STRING
   10     | BOOL
   11     | FLOAT
   12     | CHAR
   13     | VOID

   14 id_list: NAME
   15        | id_list COMMA NAME

   16 $@1: ε

   17 $@2: ε

   18 func_def: type NAME LEFT_ROUND_BRACKET $@1 param_list_opt RIGHT_ROUND_BRACKET $@2 block

   19 param_list_opt: param_list
   20               | ε

   21 param_list: param
   22           | param_list COMMA param

   23 param: type NAME

   24 block: LEFT_CURLY_BRACKET decl_list_opt stmt_list RIGHT_CURLY_BRACKET

   25 decl_list_opt: decl_list_opt var_decl
   26              | ε

   27 stmt_list: stmt_list stmt
   28          | ε

   29 stmt: assign_stmt SEMICOLON
   30     | read_stmt SEMICOLON
   31     | write_stmt SEMICOLON
   32     | return_stmt SEMICOLON
   33     | func_call_stmt SEMICOLON
   34     | if_stmt
   35     | while_stmt
   36     | do_while_stmt
   37     | block

   38 if_stmt: IF LEFT_ROUND_BRACKET expr RIGHT_ROUND_BRACKET stmt
   39        | IF LEFT_ROUND_BRACKET expr RIGHT_ROUND_BRACKET stmt ELSE stmt

   40 while_stmt: WHILE LEFT_ROUND_BRACKET expr RIGHT_ROUND_BRACKET stmt

   41 do_while_stmt: DO stmt WHILE LEFT_ROUND_BRACKET expr RIGHT_ROUND_BRACKET SEMICOLON

   42 assign_stmt: NAME ASSIGN_OP expr

   43 read_stmt: READ NAME

   44 write_stmt: WRITE expr

   45 return_stmt: RETURN expr
   46            | RETURN

   47 func_call_stmt: NAME LEFT_ROUND_BRACKET args RIGHT_ROUND_BRACKET

   48 arg_list: expr
   49         | expr COMMA arg_list

   50 args: arg_list
   51     | ε

   52 expr: expr PLUS expr
   53     | expr MINUS expr
   54     | expr MULT expr
   55     | expr DIV expr
   56     | expr GREATER_THAN expr
   57     | expr LESS_THAN expr
   58     | expr GREATER_THAN_EQUAL expr
   59     | expr LESS_THAN_EQUAL expr
   60     | expr EQUAL expr
   61     | expr NOT_EQUAL expr
   62     | expr AND expr
   63     | expr OR expr
   64     | NOT expr
   65     | MINUS expr
   66     | expr QUESTION_MARK expr COLON expr
   67     | LEFT_ROUND_BRACKET expr RIGHT_ROUND_BRACKET
   68     | NAME LEFT_ROUND_BRACKET args RIGHT_ROUND_BRACKET
   69     | NAME
   70     | INT_NUM
   71     | FLOAT_NUM
   72     | STR_CONST


