**PROCEDURE: main
**BEGIN: RTL Statements
    load:	v0 <- a_			;; Loading variable a_ into register
    sgt:	t0 <- v0 , b_
    store:	temp0 <- t0
    load:	v0 <- temp0			;; Loading variable temp0 into register
    not:	t0 <- v0
    store:	temp2 <- t0
    load:	v0 <- temp2			;; Loading variable temp2 into register
    bgtz:	v0 , Label1
    load:	v0 <- a_			;; Loading variable a_ into register
    add:	t0 <- v0 , b_
    store:	temp1 <- t0
    store:	n_ <- temp1
    goto:		Label0
Label1:
    load:	v0 <- a_			;; Loading variable a_ into register
    sub:	t0 <- v0 , b_
    store:	temp3 <- t0
    store:	n_ <- temp3
Label0:
    write:				;; This is where syscall will be made
**END: RTL Statements
